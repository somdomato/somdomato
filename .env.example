# Arquivo único de configuração. Copie para .env e preencha todos os valores
# necessários ao ambiente em que ele será usado. Nunca versione .env.
#
# O Make/Podman e o Ansible leem este mesmo arquivo. Para produção, substitua
# os valores de desenvolvimento abaixo pelos valores reais antes de executar
# `make provision` ou `make provision-tags`.

# ── Desenvolvimento / catálogo ───────────────────────────────────────────
# Caminho no host; o Podman monta exatamente este mesmo caminho.
MUSIC_PATH=/Users/lucas/Music/sdm

# Recursos opcionais da aplicação.
DEEZER_ARL=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Banco e credenciais da aplicação ─────────────────────────────────────
POSTGRES_USER=sdm
POSTGRES_PASSWORD=sdm_dev_only
POSTGRES_DB=sdm
JWT_SECRET=dev-change-me
RADIO_INTERNAL_TOKEN=dev-change-me-too

# ── Provisionamento de produção (Ansible) ─────────────────────────────────
DOMAIN=somdomato.com
SSH_PORT=2200
APP_DIR=/var/www/somdomato
MUSIC_DIR=/var/music/sdm
APP_USER=nginx
APP_GROUP=nginx
DEPLOY_USER=nginx
API_HTTP_PORT=3000

LETSENCRYPT_EMAIL=admin@example.com
ICECAST_ADMIN_EMAIL=admin@example.com
# Gere cada senha com: openssl rand -hex 16
ICECAST_SOURCE_PASSWORD=CHANGE-ME
ICECAST_RELAY_PASSWORD=CHANGE-ME
ICECAST_ADMIN_PASSWORD=CHANGE-ME
HARBOR_PASSWORD=CHANGE-ME
