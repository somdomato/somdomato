# Config de DEV LOCAL (Podman) — copie para .env na raiz e ajuste:
#   cp .env.example .env
# Nunca commitar o .env real.
#
# Para produção (Ansible) o arquivo equivalente é .env.production — veja
# .env.production.example e a seção "Produção" do README.

# Onde está o catálogo de músicas no HOST (montado como /var/music/sdm nos containers)
MUSIC_PATH=/Users/lucas/Music/sdm

POSTGRES_USER=sdm
POSTGRES_PASSWORD=sdm_dev_only
POSTGRES_DB=sdm

# openssl rand -hex 32
JWT_SECRET=dev-change-me
RADIO_INTERNAL_TOKEN=dev-change-me-too

# Feature /enviar (busca + download de músicas do Deezer). Opcional: sem
# DEEZER_ARL a rota fica desativada e o resto da aplicação sobe normal.
# Cookie "arl" de uma conta Deezer logada (idealmente premium, senão o
# download cai para mp3_128 automaticamente).
DEEZER_ARL=

# Chave da API da Groq (console.groq.com) usada para avaliar automaticamente
# as músicas baixadas antes de entrarem no catálogo. Sem ela, os downloads
# ficam pendentes indefinidamente (nada quebra, só não é aprovado sozinho).
# O avaliador chama a Groq no máximo 1x/minuto, não importa a demanda — veja
# api/internal/groqeval.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
