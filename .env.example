# ===================================================================
# EXEMPLO DE CONFIGURAÇÃO - Som do Mato
# ===================================================================
# Copie este arquivo para .env e .env.production conforme necessário
# 
# .env           = Desenvolvimento local
# .env.production = Produção

# -------------------------------------------------------------------
# STREAMING (Icecast)
# -------------------------------------------------------------------
# URL base do Icecast
# Dev:  http://localhost:8080
# Prod: https://radio.somdomato.com
NEXT_PUBLIC_RADIO_SOURCE=http://localhost:8080

# URL da API JSON de metadados do Icecast
# Dev:  http://localhost:8080/json
# Prod: https://radio.somdomato.com/json
NEXT_PUBLIC_RADIO_METADATA=http://localhost:8080/json

# -------------------------------------------------------------------
# LIQUIDSOAP
# -------------------------------------------------------------------
# URL de controle do Liquidsoap
# Dev:  http://localhost:8081 (porta diferente para evitar conflito com Nginx)
# Prod: http://localhost:8080
LIQUIDSOAP_CONTROL_URL=http://localhost:8081

# -------------------------------------------------------------------
# BANCO DE DADOS
# -------------------------------------------------------------------
# Arquivo SQLite
DB_FILE_NAME=file:drizzle/somdomato.db

# -------------------------------------------------------------------
# MÚSICAS
# -------------------------------------------------------------------
# Diretório raiz com arquivos de música
# Ajuste para o caminho correto no seu sistema
MUSIC_PATH=/home/lucas/music/sdm

# -------------------------------------------------------------------
# AUTENTICAÇÃO
# -------------------------------------------------------------------
# Senha de administrador
ADMIN_PASSWORD=
