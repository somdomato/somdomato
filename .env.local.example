# ===================================================================
# CONFIGURAÇÃO DE DESENVOLVIMENTO - Som do Mato
# ===================================================================
# Copie este arquivo para .env.local e ajuste conforme necessário

# -------------------------------------------------------------------
# STREAMING (Icecast)
# -------------------------------------------------------------------
# URL base do Icecast via proxy Nginx
NEXT_PUBLIC_RADIO_SOURCE=http://localhost:8080

# URL da API JSON de metadados do Icecast
NEXT_PUBLIC_RADIO_METADATA=http://localhost:8080/json

# Path do Socket.io (para WebSocket com Nginx)
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# -------------------------------------------------------------------
# LIQUIDSOAP
# -------------------------------------------------------------------
# URL de controle do Liquidsoap (porta 8081 em desenvolvimento)
# Em produção, usar porta 8080 (ver .env.production)
LIQUIDSOAP_CONTROL_URL=http://localhost:8081

# -------------------------------------------------------------------
# BANCO DE DADOS
# -------------------------------------------------------------------
# Arquivo SQLite
DB_FILE_NAME=file:drizzle/somdomato.db

# -------------------------------------------------------------------
# MÚSICAS
# -------------------------------------------------------------------
# Diretório raiz com arquivos de música
# Ajuste para o caminho correto no seu sistema
MUSIC_PATH=/home/lucas/music/sdm

# -------------------------------------------------------------------
# AUTENTICAÇÃO
# -------------------------------------------------------------------
# Senha de administrador (altere!)
ADMIN_PASSWORD=senha123

# ===================================================================
# NOTAS IMPORTANTES
# ===================================================================
#
# 1. Todas as URLs apontam para porta 8080 (Nginx) em vez de 8000 (Icecast)
#    pois o Nginx atua como proxy reverso em desenvolvimento.
#
# 2. O Nginx roteia:
#    - /socket.io/* → Next.js (WebSocket)
#    - /geral, /gaucha, etc. → Icecast (streams)
#    - /* → Next.js (aplicação)
#
# 3. Para iniciar o ambiente completo:
#    ./scripts/dev.sh
#
# 4. Portas utilizadas:
#    - 3000: Next.js (aplicação)
#    - 8080: Nginx (proxy reverso)
#    - 8000: Icecast (streaming direto, geralmente não acessado)
#
# ===================================================================
