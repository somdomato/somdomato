# ===================================================================
# CONFIGURAÇÃO DE PRODUÇÃO - Som do Mato
# ===================================================================
# Este arquivo é para produção
# Para desenvolvimento, use .env

# -------------------------------------------------------------------
# URL do site (usado para CORS e referer em chamadas externas)
# -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://somdomato.com

# -------------------------------------------------------------------
# STREAMING (Icecast via Nginx)
# -------------------------------------------------------------------
# URL base do Icecast via proxy Nginx (porta 8080)
# Desenvolvimento: http://localhost:8080
# Produção: https://radio.somdomato.com
NEXT_PUBLIC_RADIO_SOURCE=https://radio.somdomato.com

# -------------------------------------------------------------------
# ICECAST JSON METADATA
# -------------------------------------------------------------------
# URL da API de metadados JSON do Icecast
# Desenvolvimento: http://localhost:8080/json
# Produção: https://radio.somdomato.com/json
NEXT_PUBLIC_RADIO_METADATA=https://radio.somdomato.com/json

# -------------------------------------------------------------------
# LIQUIDSOAP
# -------------------------------------------------------------------
# URL de controle do Liquidsoap (porta 8081 em desenvolvimento)
LIQUIDSOAP_CONTROL_URL=http://localhost:8081

# -------------------------------------------------------------------
# BANCO DE DADOS
# -------------------------------------------------------------------
# Arquivo SQLite
DB_FILE_NAME=file:drizzle/somdomato.db

# -------------------------------------------------------------------
# MÚSICAS
# -------------------------------------------------------------------
# Diretório raiz com arquivos de música
# Ajuste para o caminho correto no seu sistema

# Debian
MUSIC_PATH=/var/music/sdm

# Windows (descomente e ajuste o caminho)
# MUSIC_PATH=C:\Users\Lucas\Music\sdm

# MacOS (descomente e ajuste o caminho)
# MUSIC_PATH=/Users/lucas/Music/sdm

# -------------------------------------------------------------------
# AUTENTICAÇÃO
# -------------------------------------------------------------------
ADMIN_EMAIL=somdomato@somdomato.com
ADMIN_PASSWORD=password

# -------------------------------------------------------------------
# NEXT.JS
# -------------------------------------------------------------------
# Gerar uma chave de 64 caracteres para produção (ex: openssl rand -hex 32 ou node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=c1434daff1ec296ba36a12cc22f575e5a7a61b9e75f39c1e95e6d165133ec668

# -------------------------------------------------------------------
# Envios
# -------------------------------------------------------------------
# Diretório final onde os uploads ficam disponíveis para o sistema

# Debian
UPLOADS_DIR=/var/music/sdm/uploads

# Windows (descomente e ajuste o caminho)
# UPLOADS_DIR=C:\Users\Lucas\Music\sdm\uploads

# MacOS (descomente e ajuste o caminho)
# UPLOADS_DIR=/Users/lucas/Music/sdm/uploads

# -------------------------------------------------------------------
# GoDeez
# -------------------------------------------------------------------
# Diretório onde o godeez salva os arquivos baixados (pode ser diferente do UPLOADS_DIR)
# Se não definido, usa UPLOADS_DIR

# VPS Debian(Produção)
# GODEEZ_OUTPUT_DIR=/home/nginx/Music/GoDeez/Sertanejo

# Podman (Desenvolvimento)
GODEEZ_OUTPUT_DIR=/app/uploads/godeez

# -------------------------------------------------------------------
# Deezer API
# -------------------------------------------------------------------
DEEZER_ARL=deezer_arl_token_aqui

# -------------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------------
# Nível de log (error, warn, info, debug)
LOG_LEVEL=info

# -------------------------------------------------------------------
# AUTO-APROVAÇÃO DE UPLOADS
# -------------------------------------------------------------------
# Delay em minutos antes de auto-aprovar uploads elegíveis.
# 0 = aprovação imediata. Permite ao admin rejeitar antes da aprovação.
AUTO_APPROVE_DELAY_MINUTES=5

# -------------------------------------------------------------------
# IA (Groq)
# -------------------------------------------------------------------
GROQ_API_KEY=groq_api_key_aqui
GROQ_MODEL="llama-3.3-70b-versatile"