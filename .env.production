# URL base do Icecast (servidor de streaming)  
NEXT_PUBLIC_RADIO_SOURCE=https://radio.somdomato.com

# URL da API de metadados JSON do Icecast
NEXT_PUBLIC_RADIO_METADATA=https://radio.somdomato.com/json

# URL de controle do Liquidsoap
LIQUIDSOAP_CONTROL_URL=http://localhost:8080

# Banco de dados SQLite
DB_FILE_NAME=file:drizzle/somdomato.db

# Diretório com arquivos de música (Produção)
MUSIC_PATH=/var/music/sdm

# Senha de administrador
ADMIN_PASSWORD=