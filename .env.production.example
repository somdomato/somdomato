# Config de PRODUÇÃO (Ansible) — única fonte de verdade para o provisionamento
# da VPS. Copie para .env.production, preencha os segredos e criptografe:
#   cp .env.production.example .env.production
#   ansible-vault encrypt .env.production
#
# O playbook (ansible/playbook.yml) lê este arquivo direto (decriptando com
# --ask-vault-pass) e usa os valores tanto para gerar o .env real do binário
# Go quanto para os arquivos de config nativos (Icecast2, Liquidsoap, Nginx,
# systemd). Nada de segredo fica hardcoded em ansible/*.yml.

# ── Topologia / infra ─────────────────────────────────────────────────────
DOMAIN=somdomato.com
SSH_PORT=2200
APP_DIR=/var/www/somdomato
MUSIC_DIR=/var/music/sdm
APP_USER=nginx
APP_GROUP=nginx
DEPLOY_USER=nginx
API_HTTP_PORT=3000

# ── PostgreSQL ───────────────────────────────────────────────────────────
POSTGRES_DB=somdomato
POSTGRES_USER=somdomato
POSTGRES_PASSWORD=CHANGE-ME       # openssl rand -hex 24

# ── App Go ───────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE-ME               # openssl rand -hex 32
RADIO_INTERNAL_TOKEN=CHANGE-ME     # openssl rand -hex 32

# ── SSL (Let's Encrypt) ────────────────────────────────────────────────
LETSENCRYPT_EMAIL=admin@example.com

# ── Icecast2 / Liquidsoap ──────────────────────────────────────────────
ICECAST_ADMIN_EMAIL=admin@example.com
ICECAST_SOURCE_PASSWORD=CHANGE-ME  # openssl rand -hex 16
ICECAST_RELAY_PASSWORD=CHANGE-ME   # openssl rand -hex 16
ICECAST_ADMIN_PASSWORD=CHANGE-ME   # openssl rand -hex 16
HARBOR_PASSWORD=CHANGE-ME          # openssl rand -hex 16 — senha do DJ pro input ao vivo (porta 8010)
