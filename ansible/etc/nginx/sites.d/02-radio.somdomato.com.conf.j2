server {
    listen 80;
    listen [::]:80;
    server_name radio.{{ domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name radio.{{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    # Icecast mantém a resposta aberta indefinidamente. Os defaults do proxy
    # são voltados a páginas HTTP comuns e podem encerrar/bufferizar a stream
    # antes que o elemento <audio> do navegador comece a decodificá-la.
    location / {
        # A URL pública termina em .mp3 para que o WebKit no iOS reconheça a
        # stream como áudio. O mountpoint real do Icecast não tem extensão.
        rewrite ^/(geral|gaucha|modao|arrocha|romantico)\.mp3$ /$1 break;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        gzip off;

        # O player está em outro origin (www/somdomato.com), portanto a
        # resposta da rádio precisa permanecer legível pelo navegador mesmo
        # quando Nginx responde um erro em vez do Icecast. O Icecast já
        # envia seu próprio Access-Control-Allow-Origin; sem os hides abaixo
        # o header sai duplicado na resposta (inválido pela spec de CORS e
        # rejeitado por navegadores mais estritos, como o Safari/WebKit do iOS).
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Cache-Control;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
    }
}
