[Unit]
Description=Icecast2 Streaming Media Server - Som do Mato
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=icecast2
Group=icecast
ExecStart=/usr/bin/icecast2 -c /etc/icecast2/somdomato.xml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10s

# Segurança
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/icecast2 /run

# Limites
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
