[Unit]
Description=Liquidsoap Streaming Service - Som do Mato
After=network.target icecast2-somdomato.service somdomato.service
Wants=network-online.target
Requires=icecast2-somdomato.service

[Service]
Type=simple
User=liquidsoap
Group=liquidsoap
WorkingDirectory=/var/lib/liquidsoap
ExecStart=/usr/bin/liquidsoap /etc/liquidsoap/somdomato.liq
Restart=on-failure
RestartSec=10s

# Variáveis de ambiente
Environment="HOME=/var/lib/liquidsoap"

# Segurança
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/liquidsoap /var/lib/liquidsoap /run
ReadOnlyPaths=/var/music/sdm

# Limites
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
