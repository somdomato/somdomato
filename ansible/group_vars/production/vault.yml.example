# Copie para vault.yml e criptografe antes de commitar:
#   cp vault.yml.example vault.yml
#   ansible-vault encrypt vault.yml
#
# Nunca commitar vault.yml em texto plano. Gere segredos fortes com, por
# exemplo: `openssl rand -hex 32`.

