{
  "name": "somdomato",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node --no-warnings src/server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production node src/server.ts",
    "push": "drizzle-kit push",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/db/seed.ts",
    "seed:admin": "tsx src/db/seed-admin.ts",
    "reset": "rm -f drizzle/somdomato.db && pnpm run push && pnpm run migrate && pnpm run seed",
    "lint": "biome check",
    "format": "biome format --write",
    "check": "tsc --noEmit",
    "update": "tsx ./scripts/sync-music.ts",
    "test": "vitest",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@libsql/client": "^0.17.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.562.0",
    "next": "16.2.9",
    "node-id3": "^0.2.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6"
  },
  "packageManager": "pnpm@11.6.0"
}
