# Variáveis para substituição no docker-compose.yml
# Copie para docker/.env e ajuste os caminhos

# Caminho local para os arquivos de música
# Linux/macOS:
MUSIC_PATH=/home/lucas/music/sdm
# macOS alternativo:
# MUSIC_PATH=/Users/lucas/Music/sdm
# Windows (Git Bash):
# MUSIC_PATH=/c/Users/Lucas/Music/sdm

# Sobrescreve o .env raiz para o ambiente Docker
# Stream via nginx HTTPS (evita mixed content)
NEXT_PUBLIC_RADIO_SOURCE=https://localhost/radio
NEXT_PUBLIC_RADIO_METADATA=https://localhost/radio/json
