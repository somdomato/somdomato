package components

import "github.com/somdomato/somdomato/api/config"

type NowPlaying struct {
	ID     int64
	Title  string
	Artist string
	Cover  string
	Genre  string
}

type PlayerData struct {
	Genre        config.Genre
	StreamURL    string
	Now          NowPlaying
	GenreOptions []GenreOption
}

// GenreOption é uma entrada do seletor de rádio: a URL de stream de cada
// gênero precisa vir do servidor (depende de STREAM_BASE_URL em runtime) para
// que a troca de rádio no cliente não dependa de um mapeamento fixo em JS.
type GenreOption struct {
	Genre     config.Genre
	StreamURL string
}

// PlayerBar é a barra do player embutida no header: capa, controles e troca
// de gênero em uma única faixa compacta. Assina o evento SSE
// "song-changed-<genre>" (nome específico da rádio desta página) e troca só
// a capa/título via sse-swap — sem JS customizado além do necessário para o
// <audio> trocar de fonte.
//
// O nome do evento precisa carregar o gênero porque o Hub de SSE é global:
// as cinco rádios avançam suas filas de forma independente, e um nome
// genérico faria o player trocar de música toda vez que QUALQUER rádio
// confirmasse uma faixa nova — não só a que esta página está tocando.
templ PlayerBar(data PlayerData) {
	<div class="flex flex-wrap items-center gap-3 border-t border-white/5 py-2.5 sm:flex-nowrap" sse-connect="/events">
		<div
			id="now-playing"
			sse-swap={ "song-changed-" + string(data.Genre) }
			hx-swap="innerHTML"
			data-htmx-fade
			class="flex min-w-0 flex-1 items-center gap-3 sm:flex-none"
		>
			@NowPlayingCard(data.Now)
		</div>

		<div class="flex shrink-0 items-center gap-3" data-player data-stream-url={ data.StreamURL } data-radio-name={ "Som do Mato · " + data.Genre.Label() }>
			<div class="relative">
				<button
					type="button"
					data-player-toggle
					aria-label="Reproduzir"
					class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-b from-brand-500 to-brand-600 text-white shadow-md shadow-brand-900/30 ring-1 ring-white/10 transition hover:from-brand-400 hover:to-brand-500 hover:shadow-lg hover:shadow-brand-900/40 active:scale-90 active:shadow-sm"
				>
					<svg data-icon-play class="h-3.5 w-3.5 translate-x-[1px]" viewBox="0 0 24 24" fill="currentColor">
						<path d="M8 5v14l11-7z"></path>
					</svg>
					<svg data-icon-pause class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
						<path d="M6 5h4v14H6zM14 5h4v14h-4z"></path>
					</svg>
					<svg data-icon-loading class="hidden h-3.5 w-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M21 12a9 9 0 1 1-9-9" opacity="0.9"></path>
					</svg>
				</button>

				// <div data-player-bars class="absolute -right-1.5 -bottom-1.5 flex h-2.5 items-end gap-[2px] rounded-full bg-surface px-0.5" aria-hidden="true">
				// 	<span class="w-[2px] rounded-full bg-brand-400"></span>
				// 	<span class="w-[2px] rounded-full bg-brand-400"></span>
				// 	<span class="w-[2px] rounded-full bg-brand-400"></span>
				// 	<span class="w-[2px] rounded-full bg-brand-400"></span>
				// 	<span class="w-[2px] rounded-full bg-brand-400"></span>
				// </div>
			</div>

			<button
				type="button"
				data-player-reload
				aria-label="Recarregar transmissão"
				title="Recarregar transmissão"
				class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-neutral-400 transition hover:bg-white/10 hover:text-neutral-200 active:scale-95"
			>
				<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M21 12a9 9 0 1 1-2.64-6.36"></path>
					<path d="M21 3v6h-6"></path>
				</svg>
			</button>

			<svg class="hidden h-4 w-4 shrink-0 text-neutral-400 lg:block" viewBox="0 0 24 24" fill="currentColor">
				<path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3a4.5 4.5 0 00-2.5-4.03v8.06A4.5 4.5 0 0016.5 12z"></path>
			</svg>
			<input
				type="range"
				data-player-volume
				min="0"
				max="1"
				step="0.01"
				value="0.8"
				aria-label="Volume"
				class="hidden h-1 w-16 shrink-0 cursor-pointer accent-brand-500 lg:block"
			/>

			<audio data-player-audio preload="none"></audio>
			<p data-player-message class="hidden max-w-44 text-xs text-red-400" role="status" aria-live="polite"></p>
		</div>

		@ShareButton(data.Genre)

		<div class="order-last w-full sm:order-none sm:ml-auto sm:w-auto">
			@GenreSwitcher(data.Genre, data.GenreOptions)
		</div>
	</div>
}

// ShareButton abre um popover nativo (atributo popover) com o link da rádio
// atual e atalhos de compartilhamento. O conteúdo (título/artista da faixa
// atual e da próxima) é buscado em /api/now-playing no momento da abertura —
// evita duplicar a faixa atual na fila de trocas via SSE (que hoje só
// atualiza a faixa tocando, não a próxima) e garante dado sempre fresco.
templ ShareButton(genre config.Genre) {
	<div class="relative shrink-0" data-share data-genre={ string(genre) }>
		<button
			type="button"
			popovertarget="share-popover"
			data-share-trigger
			aria-label="Compartilhar música"
			title="Compartilhar música"
			class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-neutral-400 transition hover:bg-white/10 hover:text-neutral-200 active:scale-95"
		>
			<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<circle cx="18" cy="5" r="3"></circle>
				<circle cx="6" cy="12" r="3"></circle>
				<circle cx="18" cy="19" r="3"></circle>
				<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
				<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
			</svg>
		</button>

		<div
			id="share-popover"
			popover
			data-share-popover
			class="w-[calc(100vw-2rem)] max-w-xs rounded-2xl border border-white/10 bg-surface-raised p-4 text-neutral-100 shadow-2xl shadow-black/40 backdrop:bg-black/40"
		>
			<div class="mb-3 flex items-center justify-between gap-2">
				<h2 class="text-sm font-semibold">Compartilhar música</h2>
				<button type="button" popovertarget="share-popover" popovertargetaction="hide" aria-label="Fechar" class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-neutral-400 transition hover:bg-white/10 hover:text-neutral-200">
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 6 6 18M6 6l12 12"></path>
					</svg>
				</button>
			</div>

			<div data-share-tracks class="mb-4 space-y-2">
				<label class="flex cursor-pointer items-center gap-2 rounded-lg bg-white/5 px-2.5 py-2 has-checked:ring-1 has-checked:ring-brand-500">
					<input type="radio" name="share-track" value="now" data-share-pick-now checked class="shrink-0 accent-brand-500"/>
					<span class="h-1.5 w-1.5 shrink-0 animate-pulse rounded-full bg-red-500"></span>
					<div class="min-w-0 leading-tight">
						<p data-share-now-title class="truncate text-sm font-medium">—</p>
						<p data-share-now-artist class="truncate text-xs text-neutral-400">—</p>
					</div>
				</label>
				<label data-share-next-row class="hidden flex cursor-pointer items-center gap-2 rounded-lg px-2.5 py-2 has-checked:bg-white/5 has-checked:ring-1 has-checked:ring-brand-500">
					<input type="radio" name="share-track" value="next" data-share-pick-next class="shrink-0 accent-brand-500"/>
					<div class="min-w-0 leading-tight">
						<p class="mb-0.5 text-[10px] font-semibold uppercase tracking-wide text-neutral-500">A seguir</p>
						<p data-share-next-title class="truncate text-sm font-medium text-neutral-300">—</p>
						<p data-share-next-artist class="truncate text-xs text-neutral-500">—</p>
					</div>
				</label>
			</div>

			<div class="grid grid-cols-2 gap-2">
				<button type="button" data-share-copy class="flex items-center justify-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-medium text-neutral-100 transition hover:bg-white/15 active:scale-95">
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="9" y="9" width="13" height="13" rx="2"></rect>
						<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
					</svg>
					<span data-share-copy-label>Copiar link</span>
				</button>
				<a data-share-whatsapp target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-lg bg-[#25D366]/15 px-3 py-2 text-xs font-medium text-[#25D366] transition hover:bg-[#25D366]/25 active:scale-95">
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.86 9.86 0 0 0 12.04 2zm5.8 14.14c-.24.68-1.4 1.3-1.93 1.38-.5.08-1.12.11-1.81-.11-.42-.13-.95-.31-1.64-.6-2.89-1.25-4.77-4.15-4.92-4.34-.14-.2-1.18-1.57-1.18-3 0-1.42.75-2.12 1.02-2.41.27-.29.58-.36.78-.36.2 0 .39 0 .56.01.18.01.42-.07.66.5.24.58.82 2 .89 2.15.07.15.12.32.02.51-.1.2-.15.32-.29.49-.15.17-.31.39-.44.52-.15.15-.3.31-.13.6.17.29.75 1.24 1.62 2 1.11 1 2.05 1.31 2.34 1.46.29.15.46.12.63-.07.17-.2.72-.84.92-1.13.19-.29.39-.24.65-.14.27.1 1.69.8 1.98.94.29.15.48.22.55.34.07.13.07.75-.17 1.43z"></path>
					</svg>
					WhatsApp
				</a>
				<a data-share-facebook target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-lg bg-[#1877F2]/15 px-3 py-2 text-xs font-medium text-[#1877F2] transition hover:bg-[#1877F2]/25 active:scale-95">
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
						<path d="M13.5 21v-7.5H16l.5-3.5h-3V7.7c0-1 .3-1.7 1.7-1.7H16.5V2.8C16.2 2.8 15.2 2.7 14 2.7c-2.5 0-4.2 1.5-4.2 4.3v2H7v3.5h2.8V21h3.7z"></path>
					</svg>
					Facebook
				</a>
				<a data-share-x target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-lg bg-white/10 px-3 py-2 text-xs font-medium text-neutral-100 transition hover:bg-white/20 active:scale-95">
					<svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.9 2H22l-7.6 8.7L23.3 22h-7.1l-5.5-7.2L4.4 22H1.3l8.1-9.3L1 2h7.3l5 6.6L18.9 2zm-1.2 18h1.9L7.4 4h-2l12.3 16z"></path>
					</svg>
					X
				</a>
			</div>
		</div>
	</div>
}

templ NowPlayingCard(now NowPlaying) {
	<div class="relative h-11 w-11 shrink-0 sm:h-9 sm:w-9">
		<img src={ now.Cover } alt={ now.Title } class="h-11 w-11 rounded-lg object-cover shadow-sm ring-1 ring-white/10 sm:h-9 sm:w-9"/>
	</div>
	<div class="min-w-0 leading-tight">
		<p class="max-w-[8rem] truncate text-sm font-semibold sm:max-w-[10rem]">{ now.Title }</p>
		<p class="max-w-[8rem] truncate text-xs text-neutral-400 sm:max-w-[10rem]">{ now.Artist }</p>
	</div>
}

// GenreSwitcher troca de rádio sem recarregar a página: o <select> dispara
// um hx-get que troca só #main-content (últimas/próximas/top 10 da nova
// rádio) e player.js (evento "change" delegado em document) atualiza a URL
// do stream e a capa/faixa atual do header a partir dos data-* de cada
// <option> e de /api/now-playing — o header segue com hx-preserve, então o
// <audio> nunca é destruído/recriado e a reprodução não é interrompida por
// causa da troca de rádio em si (só reinicia se já estava tocando, para
// carregar o novo stream).
templ GenreSwitcher(active config.Genre, options []GenreOption) {
	<div class="relative w-full sm:w-44">
		<select
			data-genre-select
			name="genre"
			aria-label="Selecionar rádio"
			hx-get="/"
			hx-trigger="change"
			hx-target="#main-content"
			hx-select="#main-content"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="w-full cursor-pointer appearance-none rounded-lg border border-white/10 bg-surface-raised py-1.5 pl-3 pr-8 text-xs font-medium text-neutral-200 shadow-sm transition hover:border-white/20 focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500"
		>
			for _, opt := range options {
				if opt.Genre == active {
					<option value={ string(opt.Genre) } data-stream-url={ opt.StreamURL } data-radio-name={ "Som do Mato · " + opt.Genre.Label() } selected>{ opt.Genre.Label() }</option>
				} else {
					<option value={ string(opt.Genre) } data-stream-url={ opt.StreamURL } data-radio-name={ "Som do Mato · " + opt.Genre.Label() }>{ opt.Genre.Label() }</option>
				}
			}
		</select>
		<svg class="pointer-events-none absolute right-2.5 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<path d="m6 9 6 6 6-6"></path>
		</svg>
	</div>
}
