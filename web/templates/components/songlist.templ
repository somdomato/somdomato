package components

import "time"

type SongListItem struct {
	ID        int64
	Title     string
	Artist    string
	Cover     string
	IsRequest bool
	PlayedAt  time.Time
}

// SourceBadge sinaliza se a música entrou na fila por pedido de um ouvinte
// ou por seleção automática do Auto DJ.
templ SourceBadge(isRequest bool) {
	if isRequest {
		<span class="badge-pill self-start bg-brand-500/15 text-brand-300 ring-brand-400/25">
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-2.5 w-2.5 shrink-0">
				<path d="M10 2a6 6 0 0 0-6 6v3.586l-.707.707A1 1 0 0 0 4 14h12a1 1 0 0 0 .707-1.707L16 11.586V8a6 6 0 0 0-6-6ZM8.5 16a1.5 1.5 0 0 0 3 0h-3Z"></path>
			</svg>
			Pedido
		</span>
	} else {
		<span class="badge-pill self-start bg-neutral-800 text-neutral-400 ring-white/10">
			<span class="h-1 w-1 shrink-0 rounded-full bg-neutral-500"></span>
			Auto DJ
		</span>
	}
}

templ SongList(title string, items []SongListItem, emptyMessage string) {
	<section class="mt-6 min-w-0">
		<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">{ title }</h3>
		@songListItems(items, emptyMessage, false)
	</section>
}

// SongListWithSource é igual a SongList, mas exibe o SourceBadge (Pedido /
// Auto DJ) em cada item — usado na fila "Próximas", onde a origem da
// música ainda é relevante para o ouvinte.
templ SongListWithSource(title string, items []SongListItem, emptyMessage string) {
	<section class="mt-6 min-w-0">
		<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">{ title }</h3>
		@songListItems(items, emptyMessage, true)
	</section>
}

// LiveSongList é igual a SongList/SongListWithSource, mas embrulha o
// conteúdo num container com id + sse-swap: usado na home para que
// "Últimas" e "Próximas" se atualizem em tempo real (ver broadcastQueueUpdated
// e broadcastHistoryUpdated em internal_radio.go) sem recarregar a página.
// data-flip-list ativa a animação de reordenação em list-animations.js.
templ LiveSongList(title, id, sseEvent string, items []SongListItem, emptyMessage string, showSource bool) {
	<section class="mt-6 min-w-0">
		<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">{ title }</h3>
		<div id={ id } data-flip-list sse-swap={ sseEvent } hx-swap="innerHTML">
			@songListItems(items, emptyMessage, showSource)
		</div>
	</section>
}

// SongListItemsFragment expõe songListItems para ser renderizado
// isoladamente (sem a <section> em volta) — usado para montar o payload SSE
// de "queue-updated-<genre>" / "history-updated-<genre>" em internal_radio.go.
func SongListItemsFragment(items []SongListItem, emptyMessage string, showSource bool) templ.Component {
	return songListItems(items, emptyMessage, showSource)
}

templ songListItems(items []SongListItem, emptyMessage string, showSource bool) {
	if len(items) == 0 {
		<p class="text-sm text-neutral-500">{ emptyMessage }</p>
	} else {
		<ul class="divide-y divide-white/5 rounded-lg bg-surface-raised">
			for _, item := range items {
				<li class="flex min-w-0 items-center gap-3 px-4 py-2 flip-item" data-flip-id={ "song-" + itoa(item.ID) }>
					<img src={ item.Cover } alt={ item.Title } class="h-10 w-10 shrink-0 rounded object-cover"/>
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium">{ item.Title }</p>
						<p class="truncate text-xs text-neutral-400">{ item.Artist }</p>
					</div>
					if showSource {
						@SourceBadge(item.IsRequest)
					} else if !item.PlayedAt.IsZero() {
						<time datetime={ item.PlayedAt.UTC().Format(time.RFC3339) } data-relative="true" class="shrink-0 self-start text-[9px] font-medium tracking-wide text-neutral-500"></time>
					}
				</li>
			}
		</ul>
	}
}

type TopRequestItem struct {
	SongListItem
	Count int
}

// TopRequestsList exibe o ranking de músicas mais pedidas com a contagem de
// pedidos de cada uma — usado no bloco "Top 10" da home.
templ TopRequestsList(title string, items []TopRequestItem, emptyMessage string) {
	<section class="mt-6 min-w-0">
		<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">{ title }</h3>
		@topRequestsItems(items, emptyMessage)
	</section>
}

// LiveTopRequestsList é igual a TopRequestsList, mas embrulha o conteúdo num
// container com id + sse-swap para o "Top 10" se atualizar em tempo real a
// cada novo pedido (ver broadcastTop10Updated em internal_radio.go).
templ LiveTopRequestsList(title, id, sseEvent string, items []TopRequestItem, emptyMessage string) {
	<section class="mt-6 min-w-0">
		<h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-neutral-400">{ title }</h3>
		<div id={ id } data-flip-list sse-swap={ sseEvent } hx-swap="innerHTML">
			@topRequestsItems(items, emptyMessage)
		</div>
	</section>
}

// TopRequestItemsFragment expõe topRequestsItems para ser renderizado
// isoladamente — usado para montar o payload SSE de "top10-updated" em
// internal_radio.go.
func TopRequestItemsFragment(items []TopRequestItem, emptyMessage string) templ.Component {
	return topRequestsItems(items, emptyMessage)
}

templ topRequestsItems(items []TopRequestItem, emptyMessage string) {
	if len(items) == 0 {
		<p class="text-sm text-neutral-500">{ emptyMessage }</p>
	} else {
		<ul class="divide-y divide-white/5 rounded-lg bg-surface-raised">
			for i, item := range items {
				<li class="flex min-w-0 items-center gap-3 px-4 py-2 flip-item" data-flip-id={ "song-" + itoa(item.ID) }>
					<span class="w-5 shrink-0 text-center text-xs font-semibold text-neutral-500">{ itoa(int64(i + 1)) }</span>
					<img src={ item.Cover } alt={ item.Title } class="h-10 w-10 shrink-0 rounded object-cover"/>
					<div class="min-w-0 flex-1">
						<p class="truncate text-sm font-medium">{ item.Title }</p>
						<p class="truncate text-xs text-neutral-400">{ item.Artist }</p>
					</div>
					<span class="badge-pill self-start bg-amber-500/15 text-amber-300 ring-amber-400/25">
						{ itoa(int64(item.Count)) }x
					</span>
				</li>
			}
		</ul>
	}
}

// SearchResultRow é usado em Pedidos — inclui o botão de solicitar via HTMX.
templ SearchResultRow(item SongListItem, csrfToken string) {
	<li class="flex items-center gap-3 px-4 py-2" id={ "song-" + itoa(item.ID) }>
		<img src={ item.Cover } alt={ item.Title } class="h-10 w-10 rounded object-cover"/>
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">{ item.Title }</p>
			<p class="truncate text-xs text-neutral-400">{ item.Artist }</p>
		</div>
		<form hx-post="/pedidos/solicitar" hx-target={ "#song-" + itoa(item.ID) } hx-swap="outerHTML">
			<input type="hidden" name="song_id" value={ itoa(item.ID) }/>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<button type="submit" class="rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white hover:bg-brand-500">
				Pedir
			</button>
		</form>
	</li>
}

// ArtistSongRow é usado em /artistas/{artist} — igual ao SearchResultRow
// (botão de pedir via HTMX), mas com um link "Editar" para admins logados
// que leva direto ao formulário de edição da música no painel.
templ ArtistSongRow(item SongListItem, csrfToken string, isAdmin bool) {
	<li class="flex items-center gap-3 px-4 py-2" id={ "song-" + itoa(item.ID) }>
		<img src={ item.Cover } alt={ item.Title } class="h-10 w-10 shrink-0 rounded object-cover"/>
		<div class="min-w-0 flex-1">
			<p class="truncate text-sm font-medium">{ item.Title }</p>
		</div>
		if isAdmin {
			<a href={ templ.URL("/admin/musicas/" + itoa(item.ID)) } class="shrink-0 text-xs font-medium text-neutral-400 hover:text-neutral-200 hover:underline">
				Editar
			</a>
		}
		<form hx-post="/pedidos/solicitar" hx-target={ "#song-" + itoa(item.ID) } hx-swap="outerHTML">
			<input type="hidden" name="song_id" value={ itoa(item.ID) }/>
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<button type="submit" class="shrink-0 rounded-full bg-brand-600 px-3 py-1 text-xs font-medium text-white hover:bg-brand-500">
				Pedir
			</button>
		</form>
	</li>
}

templ RequestFeedback(message string, ok bool) {
	if ok {
		<li class="px-4 py-2 text-sm text-brand-300">{ message }</li>
	} else {
		<li class="px-4 py-2 text-sm text-red-400">{ message }</li>
	}
}
