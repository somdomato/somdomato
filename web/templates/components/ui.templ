package components

// SelectArrow desenha a seta de um <select> customizado (appearance-none).
// O <select> deve estar dentro de um container `relative` e ter `pr-9`
// para abrir espaço suficiente entre a seta e a borda direita.
templ SelectArrow() {
	<svg class="pointer-events-none absolute right-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<path d="m6 9 6 6 6-6"></path>
	</svg>
}
