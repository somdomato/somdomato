package templates

import (
	"strconv"
	"strings"
	"time"

	"github.com/somdomato/somdomato/web"
	"github.com/somdomato/somdomato/web/templates/components"
)

// canonicalURL monta a URL pública da rádio atual. A stream "geral" é a raiz
// do site (sem query string) — as demais levam ?genre=<slug>, replicando a
// regra usada no botão de compartilhar (share.js) para manter og:url e o
// link compartilhado sempre idênticos.
func canonicalURL(genre string) string {
	if genre == "" || genre == "geral" {
		return web.SiteURL + "/"
	}
	return web.SiteURL + "/?genre=" + genre
}

// absoluteAssetURL garante que og:image seja sempre uma URL absoluta —
// crawlers de OpenGraph (WhatsApp, Facebook, X) não resolvem caminhos
// relativos.
func absoluteAssetURL(path string) string {
	if strings.HasPrefix(path, "http://") || strings.HasPrefix(path, "https://") {
		return path
	}
	return web.SiteURL + path
}

// ogMeta preenche as tags OpenGraph/Twitter Card a partir da faixa tocando
// agora nesta stream (quando há player) — é o que fica visível na prévia do
// link ao compartilhar via WhatsApp/X/Facebook.
templ ogMeta(player *components.PlayerData) {
	if player != nil {
		<meta property="og:type" content="music.radio_station"/>
		<meta property="og:site_name" content="Som do Mato"/>
		<meta property="og:title" content={ player.Now.Title + " – " + player.Now.Artist }/>
		<meta property="og:description" content={ "Tocando agora na rádio " + player.Genre.Label() + " da Som do Mato" }/>
		<meta property="og:url" content={ canonicalURL(string(player.Genre)) }/>
		<meta property="og:image" content={ absoluteAssetURL(player.Now.Cover) }/>
		<meta name="twitter:card" content="summary"/>
		<meta name="twitter:title" content={ player.Now.Title + " – " + player.Now.Artist }/>
		<meta name="twitter:description" content={ "Tocando agora na rádio " + player.Genre.Label() + " da Som do Mato" }/>
		<meta name="twitter:image" content={ absoluteAssetURL(player.Now.Cover) }/>
	} else {
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content="Som do Mato"/>
		<meta property="og:title" content="Som do Mato"/>
		<meta property="og:description" content="A rádio sertaneja da galera. Peça sua música, descubra novos artistas e ouça o melhor do sertanejo, 24 horas por dia."/>
		<meta property="og:url" content={ web.SiteURL + "/" }/>
		<meta property="og:image" content={ web.SiteURL + "/static/images/logotipo.svg" }/>
		<meta name="twitter:card" content="summary"/>
	}
}

templ Layout(title string, player *components.PlayerData, isAdmin bool) {
	<!DOCTYPE html>
	<html lang="pt-BR" class="dark">
		<head>
			<meta charset="UTF-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1.0" />
			if title == "" {
				<title>Som do Mato</title>
			} else {
				<title>{ title } · Som do Mato</title>
			}
			@ogMeta(player)
			<link rel="icon" type="image/svg+xml" href={ "/static/images/logotipo.svg?v=" + web.AssetVersion() } />
			<link rel="stylesheet" href={ "/static/css/output.css?v=" + web.AssetVersion() }/>
			<script src={ "/static/js/htmx.min.js?v=" + web.AssetVersion() }></script>
			<script src={ "/static/js/htmx-sse.js?v=" + web.AssetVersion() }></script>
			<script src={ "/static/js/relative-time.js?v=" + web.AssetVersion() }></script>
		</head>
		<body class="flex min-h-screen flex-col bg-surface text-neutral-100 font-sans" hx-ext="sse">
			@Header(player, isAdmin)
			<main class="mx-auto w-full max-w-5xl flex-1 px-4 py-3">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}

// Header carrega hx-boost + hx-preserve para que a navegação entre páginas
// troque só o <main>: o player (áudio, SSE, JS já ligados) segue tocando sem
// interrupção em vez de recarregar a cada clique no menu.
templ Header(player *components.PlayerData, isAdmin bool) {
	<header id="site-header" hx-boost="true" hx-preserve="true" class="sticky top-0 z-40 border-b border-white/10 bg-surface-raised/95 backdrop-blur">
		<div class="mx-auto max-w-5xl px-4">
			<div class="flex flex-col items-center gap-2 py-3 sm:flex-row sm:items-center sm:justify-between sm:gap-4">
				<a href="/" class="flex shrink-0 items-center gap-2">
					<img src={ "/static/images/logotipo.svg?v=" + web.AssetVersion() } alt="Som do Mato" class="h-8 w-auto sm:h-10"/>
					<span class="text-lg md:text-2xl font-bold">Som do Mato</span>
				</a>
				<nav class="scrollbar-hide flex w-full max-w-full justify-center gap-4 overflow-x-auto whitespace-nowrap text-sm font-medium text-neutral-300 sm:w-auto sm:justify-start sm:gap-4 sm:text-sm sm:font-normal">
					<a href="/" class="hover:text-brand-300">Início</a>
					<a href="/pedidos" class="hover:text-brand-300">Pedidos</a>
					<a href="/enviar" class="hover:text-brand-300">Enviar música</a>
					<a href="/artistas" class="hover:text-brand-300">Artistas</a>
					if isAdmin {
						<a href="/admin" class="hover:text-brand-300">Painel admin</a>
					}
				</nav>
			</div>
			if player != nil {
				@components.PlayerBar(*player)
				<script src={ "/static/js/player.js?v=" + web.AssetVersion() }></script>
				<script src={ "/static/js/share.js?v=" + web.AssetVersion() }></script>
				<script src={ "/static/js/analytics.js?v=" + web.AssetVersion() }></script>
			}
		</div>
	</header>
}

templ Footer() {
	<footer class="mt-10 border-t border-white/10 bg-surface-raised/60">
		<div class="mx-auto grid max-w-5xl grid-cols-2 gap-x-6 gap-y-10 px-4 py-12 sm:grid-cols-2 md:grid-cols-4">
			<div class="col-span-2 flex flex-col gap-3 md:col-span-1">
				<a href="/" class="flex items-center gap-2">
					<img src={ "/static/images/logotipo.svg?v=" + web.AssetVersion() } alt="Som do Mato" class="h-8 w-auto"/>
					<span class="text-lg font-bold text-neutral-100">Som do Mato</span>
				</a>
				<p class="max-w-xs text-sm leading-relaxed text-neutral-400">
					A rádio sertaneja da galera. Peça sua música, descubra novos artistas e ouça o melhor do sertanejo, 24 horas por dia.
				</p>
				<div class="mt-1 flex items-center gap-3">
					<a href="#" aria-label="Instagram" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 text-neutral-400 transition hover:bg-brand-500/20 hover:text-brand-300">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="2" width="20" height="20" rx="5"></rect>
							<circle cx="12" cy="12" r="4"></circle>
							<circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
					<a href="#" aria-label="WhatsApp" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 text-neutral-400 transition hover:bg-brand-500/20 hover:text-brand-300">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
						</svg>
					</a>
					<a href="#" aria-label="YouTube" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/5 text-neutral-400 transition hover:bg-brand-500/20 hover:text-brand-300">
						<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<rect x="2" y="5" width="20" height="14" rx="4"></rect>
							<path d="M10 9.5v5l4.5-2.5z" fill="currentColor" stroke="none"></path>
						</svg>
					</a>
				</div>
			</div>
			<div class="flex flex-col gap-3">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-200">Navegar</h3>
				<nav class="flex flex-col gap-2 text-sm text-neutral-400">
					<a href="/" class="transition hover:text-brand-300">Início</a>
					<a href="/pedidos" class="transition hover:text-brand-300">Pedidos</a>
					<a href="/enviar" class="transition hover:text-brand-300">Enviar música</a>
					<a href="/artistas" class="transition hover:text-brand-300">Artistas</a>
				</nav>
			</div>
			<div class="flex flex-col gap-3">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-200">Comunidade</h3>
				<nav class="flex flex-col gap-2 text-sm text-neutral-400">
					<a href="/enviar" class="transition hover:text-brand-300">Envie sua música</a>
					<a href="/pedidos" class="transition hover:text-brand-300">Faça um pedido</a>
					<a href="/artistas" class="transition hover:text-brand-300">Descubra artistas</a>
				</nav>
			</div>
			<div class="flex flex-col gap-3">
				<h3 class="text-sm font-semibold uppercase tracking-wider text-neutral-200">Sobre</h3>
				<nav class="flex flex-col gap-2 text-sm text-neutral-400">
					<a href="#" class="transition hover:text-brand-300">Termos de uso</a>
					<a href="#" class="transition hover:text-brand-300">Privacidade</a>
					<a href="mailto:contato@somdomato.com" class="transition hover:text-brand-300">Contato</a>
				</nav>
			</div>
		</div>
		<div class="border-t border-white/10">
			<div class="mx-auto flex max-w-5xl flex-col-reverse items-center gap-2 px-4 py-5 text-xs text-neutral-500 sm:flex-row sm:justify-between">
				<span>&copy; 2011-{ strconv.Itoa(time.Now().Year()) } Som do Mato — a mais sertaneja.</span>
				<span class="flex items-center gap-1.5">
					Por <span class="text-brand-300">&hearts;</span> à música sertaneja
				</span>
			</div>
		</div>
	</footer>
}

// CSRFField é embutido em todo formulário admin que muda estado — o valor
// bate com o cookie sdm_csrf (padrão double-submit, ver middleware.go).
templ CSRFField(token string) {
	<input type="hidden" name="csrf_token" value={ token }/>
}
