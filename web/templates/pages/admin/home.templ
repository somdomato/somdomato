package admin

import (
	"strconv"

	"github.com/somdomato/somdomato/web/templates/components"
)

// HomeSettingsPage alimenta /admin/pagina-inicial: blocos opcionais da home
// (slider de banners e chat) e a lista de banners.
type HomeSettingsPage struct {
	BannersEnabled  bool
	ChatEnabled     bool
	IntervalSeconds int
	MinInterval     int
	MaxInterval     int
	Banners         []BannerItem
	ActiveCount     int
	CSRFToken       string
	Notice          string
	Error           string
}

type BannerItem struct {
	ID      int64
	URL     string
	Title   string
	LinkURL string
	Width   int
	Height  int
	Active  bool
}

func (b BannerItem) dims() string {
	return strconv.Itoa(b.Width) + "×" + strconv.Itoa(b.Height)
}

templ HomeSettings(p HomeSettingsPage, player *components.PlayerData) {
	@Shell("Página inicial", "home", player) {
		<h1 class="text-xl font-bold">Página inicial</h1>
		<p class="mt-1 text-sm text-neutral-400">
			Escolha o que aparece no topo da home e gerencie os banners rotativos exibidos acima do chat.
		</p>
		if p.Notice != "" {
			<p class="mt-3 text-sm text-emerald-300">{ p.Notice }</p>
		}
		if p.Error != "" {
			<p class="mt-3 text-sm text-red-400">{ p.Error }</p>
		}

		<form method="POST" action="/admin/pagina-inicial/exibicao" class="mt-4 rounded-xl bg-surface-raised p-4 text-sm ring-1 ring-white/5 sm:p-5">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<h2 class="font-semibold">Exibição</h2>
			<div class="mt-3 grid gap-3 sm:grid-cols-2">
				@displaySwitch("banners_enabled", "Banners rotativos", bannersSwitchHint(p), p.BannersEnabled)
				@displaySwitch("chat_enabled", "Chat", "Chat IRC #somdomato, logo abaixo dos banners.", p.ChatEnabled)
			</div>
			<div class="mt-4 flex flex-wrap items-end gap-3">
				<label>
					Tempo de cada banner (segundos)
					<input type="number" name="interval_seconds" min={ itoaInt(p.MinInterval) } max={ itoaInt(p.MaxInterval) } value={ itoaInt(p.IntervalSeconds) } required
						class="mt-1 block w-24 rounded-lg bg-surface/60 px-3 py-2 ring-1 ring-white/10"/>
				</label>
				<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Salvar</button>
			</div>
		</form>

		<section id="banners" class="mt-8 scroll-mt-24">
			<div class="flex flex-wrap items-baseline justify-between gap-2">
				<h2 class="text-lg font-bold">Banners</h2>
				<span class="text-xs text-neutral-400">
					{ itoaInt(p.ActiveCount) } ativo(s) de { itoaInt(len(p.Banners)) }
				</span>
			</div>
			<p class="mt-1 text-xs text-neutral-500">
				A moldura do slider segue a proporção do primeiro banner; imagens com outra proporção aparecem inteiras, sobre um fundo desfocado delas mesmas — nada é esticado nem cortado. Para o melhor resultado use a mesma proporção em todos (ex.: 1920×600). JPEG e PNG são otimizados para WebP automaticamente.
			</p>

			<form method="POST" action="/admin/banners/enviar" enctype="multipart/form-data" class="mt-4">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="group flex cursor-pointer flex-col items-center justify-center gap-2 rounded-xl border-2 border-dashed border-white/10 bg-surface-raised/50 px-4 py-6 text-center text-sm transition hover:border-brand-500/50 hover:bg-surface-raised">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-500/15 text-brand-300 ring-1 ring-inset ring-brand-500/25">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5" aria-hidden="true">
							<rect x="3" y="3" width="18" height="18" rx="2"></rect>
							<circle cx="9" cy="9" r="2"></circle>
							<path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21"></path>
						</svg>
					</span>
					<span class="font-semibold text-neutral-200">Escolher imagens</span>
					<span class="text-xs text-neutral-500">JPEG, PNG, WebP ou GIF · mín. 200px · até 10MB cada, 40MB por envio</span>
					<input type="file" name="files" multiple required accept="image/jpeg,image/png,image/webp,image/gif"
						class="mt-1 block max-w-full text-xs text-neutral-400 file:mr-3 file:rounded-lg file:border-0 file:bg-surface file:px-3 file:py-1.5 file:text-neutral-100"/>
				</label>
				<div class="mt-2 flex justify-end">
					<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Enviar</button>
				</div>
			</form>

			if len(p.Banners) == 0 {
				<p class="mt-6 text-sm text-neutral-400">Nenhum banner enviado ainda. Sem banners ativos, o slider não aparece na home.</p>
			} else {
				<ul class="mt-6 grid gap-4 lg:grid-cols-2">
					for i, b := range p.Banners {
						@bannerCard(b, i, len(p.Banners), p.CSRFToken)
					}
				</ul>
			}
		</section>
	}
}

func bannersSwitchHint(p HomeSettingsPage) string {
	if p.ActiveCount == 0 {
		return "Acima do chat. Só aparece quando há ao menos um banner ativo."
	}
	return "Acima do chat, trocando sozinho quando houver mais de um."
}

templ displaySwitch(name, label, hint string, checked bool) {
	<label class="flex cursor-pointer items-start gap-3 rounded-lg bg-surface/50 p-3 ring-1 ring-white/5 transition hover:ring-white/10">
		<input type="checkbox" name={ name } value="1" class="peer sr-only" checked?={ checked }/>
		<span class="relative mt-0.5 h-6 w-11 shrink-0 rounded-full bg-white/10 ring-1 ring-inset ring-white/10 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-neutral-300 after:shadow after:transition-transform peer-checked:bg-brand-600 peer-checked:after:translate-x-5 peer-checked:after:bg-white peer-focus-visible:ring-2 peer-focus-visible:ring-brand-400" aria-hidden="true"></span>
		<span class="min-w-0">
			<span class="block font-semibold text-neutral-100">{ label }</span>
			<span class="block text-xs text-neutral-400">{ hint }</span>
		</span>
	</label>
}

templ bannerCard(b BannerItem, i, total int, csrf string) {
	<li id={ "banner-" + itoa64(b.ID) } class={ "scroll-mt-24 overflow-hidden rounded-xl bg-surface-raised ring-1 ring-white/5", templ.KV("opacity-60", !b.Active) }>
		<div class="relative h-44 overflow-hidden bg-black/40 sm:h-52">
			<img src={ b.URL } alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-110 object-cover opacity-50 blur-2xl" loading="lazy" decoding="async"/>
			<img src={ b.URL } alt={ b.Title } class="relative h-full w-full object-contain" loading="lazy" decoding="async"/>
			<span class="absolute left-2 top-2 rounded-full bg-black/60 px-2 py-0.5 text-xs font-semibold text-white backdrop-blur">{ itoaInt(i + 1) }</span>
			<span class="absolute right-2 top-2 flex gap-1">
				if !b.Active {
					<span class="rounded-full bg-black/60 px-2 py-0.5 text-xs text-neutral-300 backdrop-blur">inativo</span>
				}
				<span class="rounded-full bg-black/60 px-2 py-0.5 text-xs text-neutral-300 backdrop-blur">{ b.dims() }</span>
			</span>
		</div>
		<form method="POST" action={ templ.SafeURL("/admin/banners/" + itoa64(b.ID)) } class="grid gap-2 p-3 text-sm">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<label class="block">
				<span class="text-xs text-neutral-400">Descrição (texto alternativo)</span>
				<input type="text" name="title" value={ b.Title } maxlength="140" placeholder="Ex.: Show de sábado no Parque"
					class="mt-1 block w-full rounded-lg bg-surface/60 px-3 py-2 ring-1 ring-white/10"/>
			</label>
			<label class="block">
				<span class="text-xs text-neutral-400">Link ao clicar (opcional)</span>
				<input type="text" name="link_url" value={ b.LinkURL } maxlength="500" inputmode="url" placeholder="https://… ou /pedidos"
					class="mt-1 block w-full rounded-lg bg-surface/60 px-3 py-2 ring-1 ring-white/10"/>
			</label>
			<div class="flex justify-end">
				<button type="submit" class="rounded-lg bg-white/5 px-3 py-1.5 text-sm font-semibold text-neutral-100 ring-1 ring-inset ring-white/10 hover:bg-white/10">Salvar dados</button>
			</div>
		</form>
		<div class="flex flex-wrap items-center justify-between gap-2 border-t border-white/5 px-3 py-2 text-sm">
			<span class="flex items-center gap-1">
				@bannerMoveButton(b.ID, "up", "Mover para antes", "↑", i == 0, csrf)
				@bannerMoveButton(b.ID, "down", "Mover para depois", "↓", i == total-1, csrf)
			</span>
			<span class="flex items-center gap-4">
				<form method="POST" action={ templ.SafeURL("/admin/banners/" + itoa64(b.ID) + "/alternar") }>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button type="submit" class="text-brand-300 hover:underline">
						if b.Active {
							Desativar
						} else {
							Ativar
						}
					</button>
				</form>
				<form
					hx-post={ "/admin/banners/" + itoa64(b.ID) + "/remover" }
					hx-target="closest li"
					hx-swap="outerHTML"
					hx-confirm="Remover este banner? A imagem também será apagada."
				>
					<input type="hidden" name="csrf_token" value={ csrf }/>
					<button type="submit" class="text-red-400 hover:underline">Remover</button>
				</form>
			</span>
		</div>
	</li>
}

templ bannerMoveButton(id int64, dir, label, glyph string, disabled bool, csrf string) {
	<form method="POST" action={ templ.SafeURL("/admin/banners/" + itoa64(id) + "/mover") }>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<input type="hidden" name="dir" value={ dir }/>
		<button type="submit" title={ label } aria-label={ label } disabled?={ disabled }
			class="flex h-8 w-8 items-center justify-center rounded-lg text-neutral-300 ring-1 ring-inset ring-white/10 hover:bg-white/5 hover:text-white disabled:cursor-not-allowed disabled:opacity-30">
			{ glyph }
		</button>
	</form>
}
