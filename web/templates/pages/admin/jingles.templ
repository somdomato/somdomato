package admin

import (
	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates/components"
)

// JinglesPage alimenta as telas /admin/vinhetas (Kind "jingle") e
// /admin/comerciais (Kind "commercial") — mesma lista/envio, configuração
// diferente (Interval x Commercial).
type JinglesPage struct {
	Kind       string
	BasePath   string
	Items      []models.Jingle
	CSRFToken  string
	Notice     string
	Error      string
	Interval   int
	Commercial *CommercialConfig
}

type CommercialConfig struct {
	Mode         string // off|songs|minutes
	Order        string // random|sequential
	EverySongs   int
	EveryMinutes int
	MaxSongs     int
	MaxMinutes   int
	Streams      []CommercialStreamStatus
}

type CommercialStreamStatus struct {
	Label        string
	SongsSince   int
	MinutesSince int
	LastTitle    string
}

func (p JinglesPage) isCommercial() bool { return p.Kind == string(models.JingleKindCommercial) }

func (p JinglesPage) title() string {
	if p.isCommercial() {
		return "Comerciais"
	}
	return "Vinhetas"
}

func (p JinglesPage) active() string {
	if p.isCommercial() {
		return "commercials"
	}
	return "jingles"
}

templ JinglesList(p JinglesPage, player *components.PlayerData) {
	@Shell(p.title(), p.active(), player) {
		<h1 class="text-xl font-bold">{ p.title() }</h1>
		if p.isCommercial() {
			<p class="mt-1 text-sm text-neutral-400">
				Vinhetas comerciais tocam entre as músicas de todas as rádios. Não aparecem em “Últimas” nem “Próximas”, não podem ser pedidas e não recebem avaliações.
			</p>
		}
		if p.Notice != "" {
			<p class="mt-3 text-sm text-emerald-300">{ p.Notice }</p>
		}
		if p.Error != "" {
			<p class="mt-3 text-sm text-red-400">{ p.Error }</p>
		}

		if p.Commercial != nil {
			@commercialSettingsForm(*p.Commercial, p.CSRFToken)
		} else {
			<form method="POST" action="/admin/vinhetas/intervalo" class="mt-4 flex items-end gap-2">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<label class="text-sm">
					Intervalo (músicas entre vinhetas)
					<input type="number" min="1" name="interval" value={ itoaInt(p.Interval) }
						class="mt-1 block w-24 rounded-lg bg-surface-raised px-3 py-2"/>
				</label>
				<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Salvar</button>
			</form>
		}

		<form method="POST" action={ templ.SafeURL(p.BasePath + "/enviar") } enctype="multipart/form-data" class="mt-6 flex flex-wrap items-end gap-2">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label class="text-sm">
				Enviar arquivos (MP3 ou OGG, até 50MB por envio)
				<input type="file" name="files" multiple required accept=".mp3,.ogg,audio/mpeg,audio/ogg"
					class="mt-1 block text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-surface-raised file:px-3 file:py-2 file:text-neutral-100"/>
			</label>
			<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Enviar</button>
		</form>

		if len(p.Items) == 0 {
			<p class="mt-6 text-sm text-neutral-400">Nenhum arquivo enviado ainda.</p>
		} else {
			<ul class="mt-6 divide-y divide-white/5 rounded-lg bg-surface-raised">
				for i, j := range p.Items {
					<li class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
						<span class="min-w-0 truncate">
							if p.isCommercial() {
								<span class="mr-2 text-xs text-neutral-500">{ itoaInt(i + 1) }.</span>
							}
							{ j.Title }
							if !j.Active {
								<span class="ml-2 text-xs text-neutral-500">(inativa)</span>
							}
						</span>
						<span class="flex shrink-0 items-center gap-4">
							<form method="POST" action={ templ.SafeURL(p.BasePath + "/" + itoa64(j.ID) + "/alternar") }>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button type="submit" class="text-brand-300 hover:underline">
									if j.Active {
										Desativar
									} else {
										Ativar
									}
								</button>
							</form>
							<form
								hx-post={ p.BasePath + "/" + itoa64(j.ID) + "/remover" }
								hx-target="closest li"
								hx-swap="outerHTML"
								hx-confirm={ "Remover \"" + j.Title + "\"? O arquivo também será apagado." }
							>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button type="submit" class="text-red-400 hover:underline">Remover</button>
							</form>
						</span>
					</li>
				}
			</ul>
		}
	}
}

templ commercialSettingsForm(c CommercialConfig, csrfToken string) {
	<form method="POST" action="/admin/comerciais/config" class="mt-4 grid gap-4 rounded-lg bg-surface-raised p-4 text-sm sm:grid-cols-2">
		<input type="hidden" name="csrf_token" value={ csrfToken }/>
		<fieldset class="space-y-2">
			<legend class="font-semibold">Quando tocar</legend>
			<label class="flex items-center gap-2">
				<input type="radio" name="mode" value="off" class="accent-brand-500" checked?={ c.Mode == "off" }/>
				Desligado
			</label>
			<label class="flex flex-wrap items-center gap-2">
				<input type="radio" name="mode" value="songs" class="accent-brand-500" checked?={ c.Mode == "songs" }/>
				A cada
				<input type="number" name="every_songs" min="1" max={ itoaInt(c.MaxSongs) } value={ itoaInt(c.EverySongs) } required
					class="w-20 rounded-lg bg-surface-raised/70 px-2 py-1 ring-1 ring-white/10"/>
				músicas
			</label>
			<label class="flex flex-wrap items-center gap-2">
				<input type="radio" name="mode" value="minutes" class="accent-brand-500" checked?={ c.Mode == "minutes" }/>
				A cada
				<input type="number" name="every_minutes" min="1" max={ itoaInt(c.MaxMinutes) } value={ itoaInt(c.EveryMinutes) } required
					class="w-20 rounded-lg bg-surface-raised/70 px-2 py-1 ring-1 ring-white/10"/>
				minutos
			</label>
			<p class="text-xs text-neutral-500">No modo por minutos, o comercial entra no fim da música em andamento.</p>
		</fieldset>
		<fieldset class="space-y-2">
			<legend class="font-semibold">Ordem</legend>
			<label class="flex items-center gap-2">
				<input type="radio" name="order" value="random" class="accent-brand-500" checked?={ c.Order == "random" }/>
				Aleatória (sem repetir o mesmo comercial em seguida)
			</label>
			<label class="flex items-center gap-2">
				<input type="radio" name="order" value="sequential" class="accent-brand-500" checked?={ c.Order == "sequential" }/>
				Sequencial (na ordem da lista abaixo)
			</label>
		</fieldset>
		<div class="sm:col-span-2">
			<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Salvar</button>
		</div>
	</form>

	<h2 class="mt-6 text-sm font-semibold">Situação por rádio</h2>
	<div class="mt-2 overflow-x-auto">
		<table class="w-full text-left text-sm">
			<thead class="text-xs text-neutral-500">
				<tr>
					<th class="px-3 py-1 font-normal">Rádio</th>
					<th class="px-3 py-1 font-normal">Músicas desde o último</th>
					<th class="px-3 py-1 font-normal">Minutos desde o último</th>
					<th class="px-3 py-1 font-normal">Último comercial</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-white/5">
				for _, s := range c.Streams {
					<tr>
						<td class="px-3 py-1">{ s.Label }</td>
						<td class="px-3 py-1">{ itoaInt(s.SongsSince) }</td>
						<td class="px-3 py-1">{ itoaInt(s.MinutesSince) }</td>
						<td class="px-3 py-1">
							if s.LastTitle != "" {
								{ s.LastTitle }
							} else {
								<span class="text-neutral-500">—</span>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
	<p class="mt-1 text-xs text-neutral-500">Contadores em memória: reiniciam quando o servidor reinicia.</p>
}
