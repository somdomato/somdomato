package admin

import "github.com/somdomato/somdomato/web/templates"

templ Login(csrfToken string, errorMsg string) {
	@templates.Layout("Login", nil, false) {
		<div class="mx-auto max-w-sm">
			<h1 class="text-xl font-bold">Painel administrativo</h1>
			if errorMsg != "" {
				<p class="mt-3 rounded-lg bg-red-500/10 px-3 py-2 text-sm text-red-400">{ errorMsg }</p>
			}
			<form method="POST" action="/admin/login" class="mt-4 space-y-3">
				<input type="hidden" name="csrf_token" value={ csrfToken }/>
				<input type="email" name="email" placeholder="E-mail" required
					class="w-full rounded-lg bg-surface-raised px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"/>
				<input type="password" name="password" placeholder="Senha" required
					class="w-full rounded-lg bg-surface-raised px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"/>
				<button type="submit" class="w-full rounded-lg bg-brand-600 py-2 text-sm font-semibold text-white hover:bg-brand-500">
					Entrar
				</button>
			</form>
		</div>
	}
}
