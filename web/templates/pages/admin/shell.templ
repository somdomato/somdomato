package admin

import (
	"github.com/somdomato/somdomato/web"
	"github.com/somdomato/somdomato/web/templates"
	"github.com/somdomato/somdomato/web/templates/components"
)

// Shell é o layout comum de todas as telas do painel: navegação lateral +
// conteúdo. Cada tela chama Shell(...) por dentro em vez de Layout direto.
// player vem de buildPlayerData (mesma função usada nas páginas públicas)
// para que quem administra a rádio também consiga ouvi-la sem sair do
// painel.
templ Shell(title string, active string, player *components.PlayerData) {
	@templates.Layout("Admin · "+title, player, true) {
		<div class="grid gap-6 md:grid-cols-[180px_1fr]">
			<nav hx-boost="true" class="space-y-1 text-sm">
				@navLink("/admin", "Painel", active == "dashboard")
				@navLink("/admin/musicas", "Músicas", active == "songs")
				@navLink("/admin/pedidos", "Pedidos", active == "requests")
				@navLink("/admin/envios", "Envios", active == "uploads")
				@navLink("/admin/vinhetas", "Vinhetas", active == "jingles")
				@navLink("/admin/estatisticas", "Estatísticas", active == "stats")
				@navLink("/admin/usuarios", "Usuários", active == "users")
				<form method="POST" action="/admin/logout" class="pt-3">
					<button type="submit" class="w-full rounded-lg px-3 py-2 text-left text-red-400 hover:bg-white/5">Sair</button>
				</form>
			</nav>
			<div>
				{ children... }
			</div>
		</div>
		@confirmDialog()
		<script src={ "/static/js/admin.js?v=" + web.AssetVersion() }></script>
	}
}

// confirmDialog é um <dialog> nativo, reutilizado por qualquer form/link com
// hx-confirm nas telas do admin — substitui o confirm() feio do navegador
// por um modal com o estilo do painel (ver static/js/admin.js).
templ confirmDialog() {
	<dialog id="confirm-dialog" class="w-[90vw] max-w-sm rounded-xl border border-white/10 bg-surface-raised p-0 text-neutral-100 backdrop:bg-black/60">
		<div class="p-5">
			<p id="confirm-dialog-text" class="text-sm"></p>
			<div class="mt-5 flex justify-end gap-2">
				<button type="button" data-confirm-no class="rounded-lg px-3 py-2 text-sm text-neutral-300 hover:bg-white/5">Cancelar</button>
				<button type="button" data-confirm-yes class="rounded-lg bg-red-600 px-3 py-2 text-sm font-semibold text-white hover:bg-red-500">Confirmar</button>
			</div>
		</div>
	</dialog>
}

templ navLink(href, label string, active bool) {
	if active {
		<a href={ templ.URL(href) } class="block rounded-lg bg-brand-600 px-3 py-2 font-medium text-white">{ label }</a>
	} else {
		<a href={ templ.URL(href) } class="block rounded-lg px-3 py-2 text-neutral-300 hover:bg-white/5">{ label }</a>
	}
}
