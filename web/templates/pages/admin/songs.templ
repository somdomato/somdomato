package admin

import (
	"net/url"
	"path/filepath"
	"strconv"

	"github.com/somdomato/somdomato/api/config"
	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates/components"
)

// SongsPageInfo carrega o estado de paginação da tela de músicas do admin.
type SongsPageInfo struct {
	Query   string
	PerPage int // 0 = "Tudo" (sem paginação)
	Page    int
	Total   int
}

// TotalPages retorna o número de páginas, ou 1 quando PerPage é 0 ("Tudo").
func (p SongsPageInfo) TotalPages() int {
	if p.PerPage <= 0 {
		return 1
	}
	pages := (p.Total + p.PerPage - 1) / p.PerPage
	if pages < 1 {
		return 1
	}
	return pages
}

templ SongsList(songsList []models.Song, query, csrfToken string, page SongsPageInfo, player *components.PlayerData) {
	@Shell("Músicas", "songs", player) {
		<h1 class="text-xl font-bold">Músicas</h1>
		<form class="mt-4" hx-get="/admin/musicas" hx-target="#songs-table" hx-trigger="input changed delay:300ms">
			<input type="search" name="q" value={ query } placeholder="Buscar..."
				class="w-full rounded-lg bg-surface-raised px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"/>
		</form>
		<div id="songs-table">
			@SongsTable(songsList, csrfToken, page)
		</div>
	}
}

// songEditQueryString carrega o estado atual de busca/paginação da lista
// para dentro do link "Editar", para que o fragmento do modal (e o POST de
// salvar) devolvam a tabela na mesma página/posição em que o admin estava.
func songEditQueryString(page SongsPageInfo) string {
	v := url.Values{}
	v.Set("q", page.Query)
	v.Set("per_page", strconv.Itoa(page.PerPage))
	v.Set("page", strconv.Itoa(page.Page))
	return v.Encode()
}

// rotationOptionLabel exibe o peso numérico ao lado do nome da rotação, já
// que é isso que de fato controla a chance de a música ser sorteada pelo
// AutoDJ (ver config.RotationWeights e internal/rotation.WeightedPickAndRemove).
func rotationOptionLabel(r string) string {
	weight, ok := config.RotationWeights[config.RotationType(r)]
	if !ok {
		return r
	}
	return r + " (peso " + strconv.Itoa(weight) + ")"
}

templ songsPerPageOption(value int, label string, current int) {
	if value == current {
		<option value={ itoaInt(value) } selected>{ label }</option>
	} else {
		<option value={ itoaInt(value) }>{ label }</option>
	}
}

templ SongsTable(songsList []models.Song, csrfToken string, page SongsPageInfo) {
	<div class="mt-4 flex items-center justify-between text-xs text-neutral-500">
		<span>{ itoaInt(page.Total) } música(s)</span>
		<form
			hx-get="/admin/musicas"
			hx-target="#songs-table"
			hx-trigger="change"
			class="flex items-center gap-2"
		>
			<input type="hidden" name="q" value={ page.Query }/>
			<label class="flex items-center gap-2">
				Por página
				<span class="relative inline-block">
					<select name="per_page" class="appearance-none rounded-lg bg-surface-raised py-1 pl-2 pr-9">
						@songsPerPageOption(20, "20", page.PerPage)
						@songsPerPageOption(50, "50", page.PerPage)
						@songsPerPageOption(100, "100", page.PerPage)
						@songsPerPageOption(200, "200", page.PerPage)
						@songsPerPageOption(0, "Tudo", page.PerPage)
					</select>
					@components.SelectArrow()
				</span>
			</label>
		</form>
	</div>
	<table class="mt-2 w-full text-left text-sm">
		<thead class="text-xs uppercase text-neutral-500">
			<tr>
				<th class="px-3 py-2">Título</th>
				<th class="px-3 py-2">Artista</th>
				<th class="px-3 py-2">Gênero</th>
				<th class="px-3 py-2">Rotação</th>
				<th class="px-3 py-2"></th>
			</tr>
		</thead>
		<tbody class="divide-y divide-white/5">
			for _, s := range songsList {
				<tr id={ "song-row-" + itoa64(s.ID) }>
					<td class="px-3 py-2">{ s.Title }</td>
					<td class="px-3 py-2">{ s.Artist }</td>
					<td class="px-3 py-2">{ s.Genre }</td>
					<td class="px-3 py-2">{ s.Rotation }</td>
					<td class="px-3 py-2">
						<div class="flex items-center justify-end gap-3">
							<button
								type="button"
								hx-get={ "/admin/musicas/" + itoa64(s.ID) + "?" + songEditQueryString(page) }
								hx-target="#song-edit-dialog-content"
								class="text-neutral-300 hover:underline"
							>Editar</button>
							<form hx-post={ "/admin/musicas/" + itoa64(s.ID) + "/tocar" } hx-swap="none">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="text-brand-300 hover:underline">Tocar</button>
							</form>
							<form
								hx-post={ "/admin/musicas/" + itoa64(s.ID) + "/remover" }
								hx-target={ "#song-row-" + itoa64(s.ID) }
								hx-swap="outerHTML"
								hx-confirm={ "Apagar \"" + s.Title + "\" — " + s.Artist + "? O arquivo de áudio também será removido do disco." }
							>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="text-red-400 hover:underline">Excluir</button>
							</form>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
	if page.PerPage > 0 && page.TotalPages() > 1 {
		<div class="mt-4 flex items-center justify-center gap-3 text-sm">
			if page.Page > 1 {
				<form hx-get="/admin/musicas" hx-target="#songs-table">
					<input type="hidden" name="q" value={ page.Query }/>
					<input type="hidden" name="per_page" value={ itoaInt(page.PerPage) }/>
					<input type="hidden" name="page" value={ itoaInt(page.Page - 1) }/>
					<button type="submit" class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70">Anterior</button>
				</form>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Anterior</span>
			}
			<span class="text-neutral-400">Página { itoaInt(page.Page) } de { itoaInt(page.TotalPages()) }</span>
			if page.Page < page.TotalPages() {
				<form hx-get="/admin/musicas" hx-target="#songs-table">
					<input type="hidden" name="q" value={ page.Query }/>
					<input type="hidden" name="per_page" value={ itoaInt(page.PerPage) }/>
					<input type="hidden" name="page" value={ itoaInt(page.Page + 1) }/>
					<button type="submit" class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70">Próxima</button>
				</form>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Próxima</span>
			}
		</div>
	}
}

// SongEdit é a página completa de edição, usada como fallback acessível
// (navegação direta a /admin/musicas/{id}, sem JS). A edição do dia a dia
// acontece no modal (ver SongEditFields + songEditDialog em shell.templ).
templ SongEdit(s models.Song, csrfToken string, player *components.PlayerData) {
	@Shell("Editar música", "songs", player) {
		<h1 class="text-xl font-bold">Editar música</h1>
		<div class="mt-4 max-w-md">
			@SongEditFields(s, csrfToken, SongsPageInfo{}, false)
		</div>
	}
}

// SongEditFields é o formulário de edição em si — usado tanto pela página
// de fallback (SongEdit) quanto pelo fragmento carregado dentro do modal
// (ver handleAdminSongEditForm). inModal controla o alvo/comportamento do
// submit: dentro do modal, o POST devolve a tabela atualizada (preservando
// busca/página/scroll) e fecha o diálogo; fora dele, é uma navegação normal.
templ SongEditFields(s models.Song, csrfToken string, page SongsPageInfo, inModal bool) {
	<div class={ templ.KV("px-6 pt-6", inModal) }>
		<section class="flex items-center gap-4 rounded-xl border border-white/10 bg-surface p-3">
			<img
				src={ songCoverSrc(s.Cover) }
				alt="Capa atual"
				class="h-20 w-20 shrink-0 rounded-lg bg-surface-raised object-cover ring-1 ring-white/10"
			/>
			<div class="min-w-0 flex-1">
				<p class="truncate text-sm font-semibold">{ s.Title }</p>
				<p class="truncate text-xs text-neutral-400">{ s.Artist }</p>
				<div class="mt-2 flex flex-wrap items-center gap-2">
					<form
						method="POST"
						action={ templ.SafeURL("/admin/musicas/" + itoa64(s.ID) + "/capa") }
						enctype="multipart/form-data"
						class="flex flex-wrap items-center gap-2"
					>
						<input type="hidden" name="csrf_token" value={ csrfToken }/>
						<label class="cursor-pointer rounded-lg border border-white/10 bg-surface-raised px-3 py-1.5 text-xs font-semibold text-neutral-200 transition hover:border-brand-500/60 hover:text-white">
							Escolher imagem
							<input type="file" name="cover" accept="image/*" required class="sr-only" data-cover-input/>
						</label>
						<button type="submit" class="rounded-lg bg-brand-600/20 px-3 py-1.5 text-xs font-semibold text-brand-300 transition hover:bg-brand-600/30">Enviar capa</button>
					</form>
					if s.Cover != "" {
						<form method="POST" action={ templ.SafeURL("/admin/musicas/" + itoa64(s.ID) + "/capa/remover") }>
							<input type="hidden" name="csrf_token" value={ csrfToken }/>
							<button type="submit" class="rounded-lg px-2 py-1.5 text-xs font-semibold text-red-400 transition hover:bg-red-500/10">Remover</button>
						</form>
					}
				</div>
				<p class="mt-1 hidden truncate text-[11px] text-neutral-500" data-cover-name></p>
			</div>
		</section>
	</div>
	if inModal {
		<form
			method="POST"
			action={ templ.SafeURL("/admin/musicas/" + itoa64(s.ID)) }
			hx-post={ "/admin/musicas/" + itoa64(s.ID) }
			hx-target="#songs-table"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="modal" value="1"/>
			<input type="hidden" name="q" value={ page.Query }/>
			<input type="hidden" name="per_page" value={ strconv.Itoa(page.PerPage) }/>
			<input type="hidden" name="page" value={ strconv.Itoa(page.Page) }/>
			@songEditFormBody(s, csrfToken, true)
		</form>
	} else {
		<form
			method="POST"
			action={ templ.SafeURL("/admin/musicas/" + itoa64(s.ID)) }
			hx-boost="true"
		>
			@songEditFormBody(s, csrfToken, false)
		</form>
	}
}

// Classes compartilhadas pelos campos do formulário de edição: fundo mais
// escuro que o modal (surface vs. surface-raised) + borda, para que os
// campos sejam visíveis, e anel na cor da marca no foco.
const (
	songFieldLabel = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-neutral-400"
	songFieldInput = "w-full rounded-lg border border-white/10 bg-surface px-3 py-2 text-sm text-neutral-100 transition placeholder:text-neutral-600 focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/30"
	songFieldHint  = "mt-1.5 block text-xs leading-relaxed text-neutral-500"
	songSlotPill   = "flex cursor-pointer select-none items-center gap-2 rounded-lg border border-white/10 bg-surface px-3 py-2 text-sm text-neutral-300 transition hover:border-white/20 has-checked:border-brand-500/60 has-checked:bg-brand-600/15 has-checked:text-white"
)

templ songEditFormBody(s models.Song, csrfToken string, inModal bool) {
	<input type="hidden" name="csrf_token" value={ csrfToken }/>
	<div class={ "space-y-5", templ.KV("px-6 py-6", inModal), templ.KV("mt-5", !inModal) }>
		<label class="block">
			<span class={ songFieldLabel }>Título</span>
			<input type="text" name="title" value={ s.Title } class={ songFieldInput }/>
		</label>
		<label class="block">
			<span class={ songFieldLabel }>Artista</span>
			<input type="text" name="artist" value={ s.Artist } class={ songFieldInput }/>
		</label>
		<label class="block">
			<span class={ songFieldLabel }>Nome do arquivo</span>
			<input type="text" name="filename" value={ filepath.Base(s.Path) } class={ songFieldInput, "font-mono text-xs" }/>
			<span class={ songFieldHint }>Renomeia o arquivo em disco (fica na mesma pasta; a extensão .mp3/.ogg não pode mudar). Título e artista também são gravados nas tags do arquivo (ID3 no MP3, Vorbis comments no OGG).</span>
		</label>
		<div class="grid gap-5 sm:grid-cols-2">
			<label class="block">
				<span class={ songFieldLabel }>Gênero</span>
				<span class="relative block">
					<select name="genre" class={ songFieldInput, "appearance-none pr-9" }>
						for _, g := range config.AllGenres {
							if string(g) == s.Genre {
								<option value={ string(g) } selected>{ g.Label() }</option>
							} else {
								<option value={ string(g) }>{ g.Label() }</option>
							}
						}
					</select>
					@components.SelectArrow()
				</span>
			</label>
			<label class="block">
				<span class={ songFieldLabel }>Rotação</span>
				<span class="relative block">
					<select name="rotation" class={ songFieldInput, "appearance-none pr-9" }>
						for _, r := range []string{"inativo", "ultraleve", "leve", "normal", "pesado", "ultrapesada"} {
							if r == s.Rotation {
								<option value={ r } selected>{ rotationOptionLabel(r) }</option>
							} else {
								<option value={ r }>{ rotationOptionLabel(r) }</option>
							}
						}
					</select>
					@components.SelectArrow()
				</span>
			</label>
		</div>
		<p class={ songFieldHint, "-mt-3" }>Rotação é o peso no sorteio do AutoDJ: peso maior = mais chance de ser sorteada. Restrições de música/artista repetido continuam sendo respeitadas.</p>
		<fieldset>
			<legend class={ songFieldLabel }>Horários (AutoDJ)</legend>
			<div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
				<label class={ songSlotPill }>
					<input type="checkbox" name="time_slots" value="1" class="accent-brand-500" checked?={ s.TimeSlots&int(config.SlotMadrugada) != 0 }/>
					Madrugada
				</label>
				<label class={ songSlotPill }>
					<input type="checkbox" name="time_slots" value="2" class="accent-brand-500" checked?={ s.TimeSlots&int(config.SlotManha) != 0 }/>
					Manhã
				</label>
				<label class={ songSlotPill }>
					<input type="checkbox" name="time_slots" value="4" class="accent-brand-500" checked?={ s.TimeSlots&int(config.SlotTarde) != 0 }/>
					Tarde
				</label>
				<label class={ songSlotPill }>
					<input type="checkbox" name="time_slots" value="8" class="accent-brand-500" checked?={ s.TimeSlots&int(config.SlotNoite) != 0 }/>
					Noite
				</label>
			</div>
			<span class={ songFieldHint }>Nenhum ou todos marcados = toca em qualquer horário. Não afeta pedidos, só o AutoDJ.</span>
		</fieldset>
		<label class="flex cursor-pointer items-center justify-between gap-4 rounded-xl border border-white/10 bg-surface px-4 py-3">
			<span>
				<span class="block text-sm font-semibold">Permitir no Geral</span>
				<span class="block text-xs text-neutral-500">Além do próprio gênero, também entra no sorteio do Geral.</span>
			</span>
			<input type="checkbox" name="allowed_in_general" class="h-4 w-4 accent-brand-500" checked?={ s.AllowedInGeneral }/>
		</label>
	</div>
	if inModal {
		<div class="sticky bottom-0 flex justify-end gap-2 border-t border-white/10 bg-surface-raised/95 px-6 py-4 backdrop-blur">
			<button type="button" data-modal-close class="rounded-lg px-4 py-2 text-sm font-semibold text-neutral-300 transition hover:bg-white/5">Cancelar</button>
			<button type="submit" class="rounded-lg bg-brand-600 px-5 py-2 text-sm font-semibold text-white shadow-lg shadow-brand-900/40 transition hover:bg-brand-500">Salvar alterações</button>
		</div>
	} else {
		<button type="submit" class="mt-6 rounded-lg bg-brand-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-brand-500">Salvar alterações</button>
	}
}
