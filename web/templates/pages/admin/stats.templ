package admin

import (
	"strconv"
	"strings"

	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates/components"
)

type StatsData struct {
	Period       models.Period
	Totals       models.AnalyticsTotals
	Pages        []models.PageStat
	PagesInfo    PagesPageInfo
	VisitSeries  []models.VisitPoint
	ListenSeries []models.ListenerPoint
}

// PagesPageInfo carrega o estado de paginação da tabela "Visitas e cliques
// por página" em /admin/estatisticas.
type PagesPageInfo struct {
	Page    int
	PerPage int
	Total   int
}

func (p PagesPageInfo) TotalPages() int {
	if p.PerPage <= 0 {
		return 1
	}
	pages := (p.Total + p.PerPage - 1) / p.PerPage
	if pages < 1 {
		return 1
	}
	return pages
}

func pageLabel(path string) string {
	switch path {
	case "/":
		return "Início"
	case "/pedidos":
		return "Pedidos"
	case "/artistas":
		return "Artistas"
	case "/enviar":
		return "Enviar música"
	}
	if strings.HasPrefix(path, "/artistas/") {
		return "Artista: " + strings.TrimPrefix(path, "/artistas/")
	}
	return path
}

func statsURL(period models.Period, page int) string {
	url := "/admin/estatisticas?periodo=" + string(period)
	if page > 1 {
		url += "&page=" + strconv.Itoa(page)
	}
	return url
}

templ Stats(data StatsData, player *components.PlayerData) {
	@Shell("Estatísticas", "stats", player) {
		<h1 class="text-xl font-bold">Estatísticas</h1>
		@StatsContent(data)
	}
}

templ StatsContent(data StatsData) {
	<div
		id="stats-content"
		class="mt-4 space-y-6"
		hx-get={ statsURL(data.Period, data.PagesInfo.Page) }
		hx-trigger="every 20s"
		hx-target="this"
		hx-swap="outerHTML"
	>
		<div class="flex flex-wrap gap-2">
			for _, p := range models.AllPeriods {
				@periodTab(p, data.Period)
			}
		</div>

		<div class="grid gap-3 sm:grid-cols-3">
			@statCard("Visitas", strconv.FormatInt(data.Totals.Visits, 10), "cliente único")
			@statCard("Cliques", strconv.FormatInt(data.Totals.Clicks, 10), "todos os acessos")
			@statCard("Online agora", strconv.FormatInt(data.Totals.Online, 10), "últimos 60s")
		</div>

		<div class="rounded-lg bg-surface-raised p-4">
			<h2 class="text-sm font-semibold text-neutral-200">Visitas e cliques</h2>
			<div class="mt-3">
				@visitChart(data.VisitSeries, data.Period)
			</div>
		</div>

		<div class="rounded-lg bg-surface-raised p-4">
			<h2 class="text-sm font-semibold text-neutral-200">Ouvintes por rádio</h2>
			<div class="mt-3">
				@listenerChart(data.ListenSeries, data.Period)
			</div>
		</div>

		<div>
			<h2 class="text-sm font-semibold text-neutral-200">Visitas e cliques por página</h2>
			<table class="mt-3 w-full text-left text-sm">
				<thead class="text-xs uppercase text-neutral-500">
					<tr>
						<th class="px-3 py-2">Página</th>
						<th class="px-3 py-2">Path</th>
						<th class="px-3 py-2 text-right">Visitas</th>
						<th class="px-3 py-2 text-right">Cliques</th>
						<th class="px-3 py-2 text-right">Online agora</th>
					</tr>
				</thead>
				<tbody class="divide-y divide-white/5">
					for _, pg := range data.Pages {
						<tr>
							<td class="px-3 py-2">{ pageLabel(pg.Path) }</td>
							<td class="px-3 py-2 font-mono text-xs text-neutral-500">{ pg.Path }</td>
							<td class="px-3 py-2 text-right">{ strconv.FormatInt(pg.Visits, 10) }</td>
							<td class="px-3 py-2 text-right">{ strconv.FormatInt(pg.Clicks, 10) }</td>
							<td class="px-3 py-2 text-right">{ strconv.FormatInt(pg.Online, 10) }</td>
						</tr>
					}
					if len(data.Pages) == 0 {
						<tr>
							<td colspan="5" class="px-3 py-4 text-center text-neutral-500">Sem dados no período.</td>
						</tr>
					}
				</tbody>
			</table>
			@pagesPager(data.Period, data.PagesInfo)
		</div>
	</div>
}

templ pagesPager(period models.Period, page PagesPageInfo) {
	if page.TotalPages() > 1 {
		<div class="mt-4 flex items-center justify-center gap-3 text-sm">
			if page.Page > 1 {
				<a
					href={ templ.URL(statsURL(period, page.Page-1)) }
					hx-get={ statsURL(period, page.Page-1) }
					hx-target="#stats-content"
					hx-swap="outerHTML"
					hx-push-url="true"
					class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70"
				>Anterior</a>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Anterior</span>
			}
			<span class="text-neutral-400">Página { strconv.Itoa(page.Page) } de { strconv.Itoa(page.TotalPages()) }</span>
			if page.Page < page.TotalPages() {
				<a
					href={ templ.URL(statsURL(period, page.Page+1)) }
					hx-get={ statsURL(period, page.Page+1) }
					hx-target="#stats-content"
					hx-swap="outerHTML"
					hx-push-url="true"
					class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70"
				>Próxima</a>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Próxima</span>
			}
		</div>
	}
}

templ periodTab(p, active models.Period) {
	if p == active {
		<span class="rounded-lg bg-brand-600 px-3 py-1.5 text-sm font-medium text-white">{ p.Label() }</span>
	} else {
		<a
			href={ templ.URL(statsURL(p, 1)) }
			hx-get={ statsURL(p, 1) }
			hx-target="#stats-content"
			hx-swap="outerHTML"
			hx-push-url="true"
			class="rounded-lg px-3 py-1.5 text-sm text-neutral-300 hover:bg-white/5"
		>{ p.Label() }</a>
	}
}

templ statCard(label, value, hint string) {
	<div class="rounded-lg bg-surface-raised p-4">
		<p class="text-xs font-semibold uppercase text-brand-300">{ label }</p>
		<p class="mt-1 text-2xl font-bold">{ value }</p>
		<p class="mt-1 text-xs text-neutral-500">{ hint }</p>
	</div>
}
