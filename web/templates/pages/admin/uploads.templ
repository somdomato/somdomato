package admin

import (
	"github.com/somdomato/somdomato/api/config"
	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates/components"
)

// UploadsPageInfo carrega o estado de filtro/paginação da tela de envios.
type UploadsPageInfo struct {
	Status  string // "" = todos
	PerPage int
	Page    int
	Total   int
}

func (p UploadsPageInfo) TotalPages() int {
	pages := (p.Total + p.PerPage - 1) / p.PerPage
	if pages < 1 {
		return 1
	}
	return pages
}

var uploadStatusLabels = map[string]string{
	"":           "Todos",
	"pending":    "Pendente",
	"evaluating": "Avaliando",
	"approved":   "Aprovado",
	"rejected":   "Rejeitado",
}

var uploadStatusOrder = []string{"", "pending", "evaluating", "approved", "rejected"}

templ statusFilterOption(value, label, current string) {
	if value == current {
		<option value={ value } selected>{ label }</option>
	} else {
		<option value={ value }>{ label }</option>
	}
}

func uploadStatusBadgeClass(status string) string {
	switch status {
	case "approved":
		return "bg-emerald-500/20 text-emerald-300"
	case "rejected":
		return "bg-red-500/20 text-red-300"
	case "evaluating":
		return "bg-amber-500/20 text-amber-300"
	default:
		return "bg-neutral-500/20 text-neutral-300"
	}
}

templ UploadsList(list []models.Upload, csrfToken string, page UploadsPageInfo, player *components.PlayerData) {
	@Shell("Envios", "uploads", player) {
		<h1 class="text-xl font-bold">Envios</h1>
		<p class="mt-1 text-sm text-neutral-500">
			Faixas baixadas via /enviar, aguardando ou já avaliadas pela IA (Groq) antes de entrar no catálogo.
		</p>
		<form class="mt-4 flex items-center gap-2 text-sm" hx-get="/admin/envios" hx-target="#uploads-table">
			<label class="flex items-center gap-2">
				Status
				<span class="relative inline-block">
					<select name="status" class="appearance-none rounded-lg bg-surface-raised py-1 pl-2 pr-9" hx-get="/admin/envios" hx-target="#uploads-table" hx-trigger="change">
						for _, s := range uploadStatusOrder {
							@statusFilterOption(s, uploadStatusLabels[s], page.Status)
						}
					</select>
					@components.SelectArrow()
				</span>
			</label>
		</form>
		<div id="uploads-table">
			@UploadsTable(list, csrfToken, page)
		</div>
	}
}

templ UploadRow(u models.Upload, csrfToken string) {
	<li id={ "upload-row-" + itoa64(u.ID) } class="flex items-center justify-between gap-3 px-4 py-2 text-sm">
		<div class="min-w-0">
			<div class="flex items-center gap-2">
				<span class="truncate">{ u.Title } — { u.Artist }</span>
				<span class={ "shrink-0 rounded-full px-2 py-0.5 text-xs " + uploadStatusBadgeClass(string(u.Status)) }>
					{ uploadStatusLabels[string(u.Status)] }
				</span>
			</div>
			if u.AIReason != nil && *u.AIReason != "" {
				<p class="mt-0.5 truncate text-xs text-neutral-500">{ *u.AIReason }</p>
			}
		</div>
		<div class="flex shrink-0 items-center gap-3">
			<a href={ templ.URL("/admin/envios/" + itoa64(u.ID)) } class="text-neutral-300 hover:underline">Editar</a>
			if u.Status != "approved" {
				<form hx-post={ "/admin/envios/" + itoa64(u.ID) + "/aprovar" } hx-target={ "#upload-row-" + itoa64(u.ID) } hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="text-brand-300 hover:underline">Aprovar</button>
				</form>
			}
			if u.Status != "rejected" {
				<form hx-post={ "/admin/envios/" + itoa64(u.ID) + "/negar" } hx-target={ "#upload-row-" + itoa64(u.ID) } hx-swap="outerHTML">
					<input type="hidden" name="csrf_token" value={ csrfToken }/>
					<button type="submit" class="text-red-400 hover:underline">Negar</button>
				</form>
			}
		</div>
	</li>
}

templ UploadsTable(list []models.Upload, csrfToken string, page UploadsPageInfo) {
	<div class="mt-4 text-xs text-neutral-500">{ itoaInt(page.Total) } envio(s)</div>
	if len(list) == 0 {
		<p class="mt-4 text-sm text-neutral-500">Nenhum envio encontrado.</p>
	} else {
		<ul class="mt-2 divide-y divide-white/5 rounded-lg bg-surface-raised">
			for _, u := range list {
				@UploadRow(u, csrfToken)
			}
		</ul>
	}
	if page.TotalPages() > 1 {
		<div class="mt-4 flex items-center justify-center gap-3 text-sm">
			if page.Page > 1 {
				<form hx-get="/admin/envios" hx-target="#uploads-table">
					<input type="hidden" name="status" value={ page.Status }/>
					<input type="hidden" name="page" value={ itoaInt(page.Page - 1) }/>
					<button type="submit" class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70">Anterior</button>
				</form>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Anterior</span>
			}
			<span class="text-neutral-400">Página { itoaInt(page.Page) } de { itoaInt(page.TotalPages()) }</span>
			if page.Page < page.TotalPages() {
				<form hx-get="/admin/envios" hx-target="#uploads-table">
					<input type="hidden" name="status" value={ page.Status }/>
					<input type="hidden" name="page" value={ itoaInt(page.Page + 1) }/>
					<button type="submit" class="rounded-lg bg-surface-raised px-3 py-1 hover:bg-surface-raised/70">Próxima</button>
				</form>
			} else {
				<span class="rounded-lg px-3 py-1 text-neutral-600">Próxima</span>
			}
		</div>
	}
}

templ UploadEdit(u models.Upload, csrfToken string, player *components.PlayerData) {
	@Shell("Editar envio", "uploads", player) {
		<h1 class="text-xl font-bold">Editar envio</h1>
		<p class="mt-1 text-sm text-neutral-500">
			Status atual:
			<span class={ "rounded-full px-2 py-0.5 text-xs " + uploadStatusBadgeClass(string(u.Status)) }>
				{ uploadStatusLabels[string(u.Status)] }
			</span>
		</p>
		if u.AIReason != nil && *u.AIReason != "" {
			<p class="mt-2 text-sm text-neutral-400">Parecer da IA: { *u.AIReason }</p>
		}
		<form method="POST" action={ templ.SafeURL("/admin/envios/" + itoa64(u.ID)) } class="mt-4 max-w-md space-y-3">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label class="block text-sm">
				Título
				<input type="text" name="title" value={ u.Title } class="mt-1 w-full rounded-lg bg-surface-raised px-3 py-2"/>
			</label>
			<label class="block text-sm">
				Artista
				<input type="text" name="artist" value={ u.Artist } class="mt-1 w-full rounded-lg bg-surface-raised px-3 py-2"/>
			</label>
			<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Salvar</button>
		</form>
		<form method="POST" action={ templ.SafeURL("/admin/envios/" + itoa64(u.ID) + "/aprovar") } class="mt-4 flex max-w-md items-end gap-2">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label class="block text-sm">
				Gênero para aprovar
				<span class="relative mt-1 block">
					<select name="genre" class="w-full appearance-none rounded-lg bg-surface-raised py-2 pl-3 pr-9">
						for _, g := range config.AllGenres {
							if u.AIGenre != nil && string(g) == *u.AIGenre {
								<option value={ string(g) } selected>{ g.Label() }</option>
							} else {
								<option value={ string(g) }>{ g.Label() }</option>
							}
						}
					</select>
					@components.SelectArrow()
				</span>
			</label>
			<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white">Aprovar</button>
		</form>
		<form method="POST" action={ templ.SafeURL("/admin/envios/" + itoa64(u.ID) + "/negar") } class="mt-3 max-w-md">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<button type="submit" class="rounded-lg bg-red-600/90 px-4 py-2 text-sm font-semibold text-white hover:bg-red-500">Negar</button>
		</form>
	}
}
