package admin

import (
	"github.com/somdomato/somdomato/api/rbac"
	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates/components"
)

templ UsersList(list []models.User, csrfToken string, player *components.PlayerData) {
	@Shell("Usuários", "users", player) {
		<h1 class="text-xl font-bold">Usuários</h1>
		<table class="mt-4 w-full text-left text-sm">
			<thead class="text-xs uppercase text-neutral-500">
				<tr>
					<th class="px-3 py-2">Nome</th>
					<th class="px-3 py-2">E-mail</th>
					<th class="px-3 py-2">Papel</th>
					<th class="px-3 py-2"></th>
				</tr>
			</thead>
			<tbody class="divide-y divide-white/5">
				for _, u := range list {
					<tr id={ "user-row-" + itoa64(u.ID) }>
						<td class="px-3 py-2">{ u.Name }</td>
						<td class="px-3 py-2">{ u.Email }</td>
						<td class="px-3 py-2">
							<form hx-post={ "/admin/usuarios/" + itoa64(u.ID) + "/papel" } hx-swap="none" class="flex items-center gap-2">
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<span class="relative inline-block">
									<select name="role" class="appearance-none rounded-lg bg-surface-raised py-1 pl-2 pr-9">
										for _, r := range rbac.AllRoles {
											if string(r) == u.Role {
												<option value={ string(r) } selected>{ rbac.RoleLabels[r] }</option>
											} else {
												<option value={ string(r) }>{ rbac.RoleLabels[r] }</option>
											}
										}
									</select>
									@components.SelectArrow()
								</span>
								<button type="submit" class="text-brand-300 hover:underline">Salvar</button>
							</form>
						</td>
						<td class="px-3 py-2 text-right">
							<form
								hx-post={ "/admin/usuarios/" + itoa64(u.ID) + "/remover" }
								hx-target={ "#user-row-" + itoa64(u.ID) }
								hx-swap="outerHTML"
								hx-confirm={ "Remover o admin \"" + u.Name + "\" (" + u.Email + ")?" }
							>
								<input type="hidden" name="csrf_token" value={ csrfToken }/>
								<button type="submit" class="text-red-400 hover:underline">Excluir</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>

		<h2 class="mt-8 text-lg font-bold">Adicionar admin</h2>
		<form method="POST" action="/admin/usuarios" hx-boost="true" class="mt-3 max-w-md space-y-3">
			<input type="hidden" name="csrf_token" value={ csrfToken }/>
			<label class="block text-sm">
				Nome
				<input type="text" name="name" required class="mt-1 w-full rounded-lg bg-surface-raised px-3 py-2"/>
			</label>
			<label class="block text-sm">
				E-mail
				<input type="email" name="email" required class="mt-1 w-full rounded-lg bg-surface-raised px-3 py-2"/>
			</label>
			<label class="block text-sm">
				Senha
				<input type="password" name="password" required minlength="8" class="mt-1 w-full rounded-lg bg-surface-raised px-3 py-2"/>
			</label>
			<label class="block text-sm">
				Papel
				<span class="relative mt-1 block">
					<select name="role" class="w-full appearance-none rounded-lg bg-surface-raised px-3 py-2">
						for _, r := range rbac.AllRoles {
							if rbac.IsAdminRole(string(r)) {
								<option value={ string(r) }>{ rbac.RoleLabels[r] }</option>
							}
						}
					</select>
					@components.SelectArrow()
				</span>
			</label>
			<button type="submit" class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-500">Criar admin</button>
		</form>
	}
}
