package pages

import (
	"net/url"
	"strconv"

	"github.com/somdomato/somdomato/api/models"
	"github.com/somdomato/somdomato/web/templates"
	"github.com/somdomato/somdomato/web/templates/components"
)

// CoverCandidate espelha artistcover.Candidate (api/internal/artistcover) —
// não dá pra importar aquele pacote diretamente aqui (é "internal" fora da
// árvore de api/), então httpserver converte na hora de montar
// ArtistDetailData (ver handleArtistDetail em httpserver/public.go).
type CoverCandidate struct {
	Source   string
	ThumbURL string
	FullURL  string
}

type ArtistasData struct {
	Player  components.PlayerData
	Artists []models.ArtistCard
	IsAdmin bool
}

templ Artistas(data ArtistasData) {
	@templates.Layout("Artistas", &data.Player, data.IsAdmin) {
		<h1 class="text-xl font-bold">Artistas</h1>
		<p class="mt-1 text-sm text-neutral-400">Escolha um artista para ver e pedir as músicas dele.</p>
		<ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 md:grid-cols-4">
			for _, artist := range data.Artists {
				<li>
					<a
						href={ templ.URL("/artistas/" + url.PathEscape(artist.Name)) }
						class="group block overflow-hidden rounded-xl bg-surface-raised shadow-lg ring-1 ring-white/5 transition duration-200 hover:-translate-y-0.5 hover:shadow-brand-500/10 hover:ring-brand-400/40"
					>
						<div class="relative aspect-square overflow-hidden">
							<img
								src={ artist.Cover }
								alt={ artist.Name }
								loading="lazy"
								class="h-full w-full object-cover transition duration-300 group-hover:scale-105"
							/>
							<div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/10 to-transparent"></div>
							<div class="absolute inset-x-0 bottom-0 p-3">
								<p class="truncate text-sm font-semibold text-white">{ artist.Name }</p>
								<span class="badge-pill mt-1 bg-white/10 text-neutral-200 ring-white/15">
									{ strconv.Itoa(artist.SongCount) } música{ pluralSuffix(artist.SongCount) }
								</span>
							</div>
						</div>
					</a>
				</li>
			}
		</ul>
	}
}

func pluralSuffix(n int) string {
	if n == 1 {
		return ""
	}
	return "s"
}

type ArtistDetailData struct {
	Artist        string
	Songs         []components.SongListItem
	Cover         string
	IsManualCover bool
	Player        components.PlayerData
	CSRFToken     string
	IsAdmin       bool

	// CoverCandidates e SearchedCovers alimentam a busca forçada de capa
	// (?buscar_capa=1, ver handleArtistDetail em httpserver/public.go e
	// artistcover.Resolver.FindCandidates) — SearchedCovers distingue "não
	// buscou ainda" de "buscou e não achou nada".
	CoverCandidates []CoverCandidate
	SearchedCovers  bool
}

templ ArtistDetail(data ArtistDetailData) {
	@templates.Layout(data.Artist, &data.Player, data.IsAdmin) {
		<a
			href="/artistas"
			onclick="try{var u=new window.URL(document.referrer);if(u.origin===location.origin&&u.pathname==='/artistas'){event.preventDefault();setTimeout(function(){history.back();},0);}}catch(e){}"
			class="mb-4 inline-flex items-center gap-1.5 rounded-full bg-surface-raised px-3 py-1.5 text-sm font-medium text-neutral-300 shadow ring-1 ring-white/10 transition hover:-translate-x-0.5 hover:bg-white/10 hover:text-white active:translate-x-0"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0">
				<path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd"></path>
			</svg>
			<span class="hidden sm:inline">Voltar a todos os artistas</span>
			<span class="sm:hidden">Artistas</span>
		</a>

		<div class="flex items-center gap-4">
			if data.Cover != "" {
				<img src={ data.Cover } alt={ data.Artist } class="h-20 w-20 shrink-0 rounded-xl object-cover shadow-lg"/>
			}
			<div class="min-w-0">
				<h1 class="truncate text-xl font-bold">{ data.Artist }</h1>
				<p class="text-sm text-neutral-400">
					{ strconv.Itoa(len(data.Songs)) } música{ pluralSuffix(len(data.Songs)) }
				</p>
			</div>
		</div>

		if data.IsAdmin {
			<details class="mt-3 rounded-lg bg-surface-raised px-4 py-2 text-sm">
				<summary class="cursor-pointer select-none font-medium text-neutral-300">Editar artista</summary>
				<form method="POST" action={ templ.SafeURL("/admin/artistas/" + url.PathEscape(data.Artist) + "/renomear") } class="mt-3 flex flex-wrap items-center gap-2">
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<input
						type="text"
						name="artist"
						value={ data.Artist }
						class="min-w-0 flex-1 rounded-lg bg-surface px-3 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
					/>
					<button type="submit" class="rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white hover:bg-brand-500">
						Salvar
					</button>
				</form>
				<p class="mt-2 text-xs text-neutral-500">Renomeia o artista em todas as músicas dele.</p>

				<form
					method="POST"
					action={ templ.SafeURL("/admin/artistas/" + url.PathEscape(data.Artist) + "/capa") }
					enctype="multipart/form-data"
					class="mt-3 flex flex-wrap items-center gap-2 border-t border-white/5 pt-3"
				>
					<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
					<input
						type="file"
						name="cover"
						accept="image/*"
						required
						class="min-w-0 flex-1 text-xs text-neutral-400 file:mr-2 file:rounded-lg file:border-0 file:bg-brand-600 file:px-3 file:py-2 file:text-xs file:font-semibold file:text-white hover:file:bg-brand-500"
					/>
					<button type="submit" class="rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white hover:bg-brand-500">
						Enviar capa
					</button>
				</form>
				<p class="mt-2 text-xs text-neutral-500">Envia uma capa customizada — a busca automática nunca mais roda pra este artista.</p>

				if data.IsManualCover {
					<form method="POST" action={ templ.SafeURL("/admin/artistas/" + url.PathEscape(data.Artist) + "/capa/remover") } class="mt-2">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<button type="submit" class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-neutral-200 hover:bg-white/20">
							Remover capa customizada
						</button>
					</form>
				}

				<div class="mt-3 border-t border-white/5 pt-3">
					<form
						method="POST"
						action={ templ.SafeURL("/admin/artistas/" + url.PathEscape(data.Artist) + "/capa/apagar") }
						onsubmit="return confirm('Apagar a capa atual e voltar para o logotipo padrão? A busca automática não roda de novo para este artista até você forçar uma nova busca.')"
					>
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
						<button type="submit" class="rounded-lg bg-white/10 px-3 py-2 text-xs font-semibold text-red-300 hover:bg-white/20">
							Apagar capa
						</button>
					</form>
					<p class="mt-2 text-xs text-neutral-500">Volta para o logotipo padrão do site e trava a busca automática pra este artista.</p>
				</div>

				<div class="mt-3 border-t border-white/5 pt-3">
					<a
						href={ templ.URL("/artistas/" + url.PathEscape(data.Artist) + "?buscar_capa=1") }
						class="inline-block rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white hover:bg-brand-500"
					>
						Forçar busca de capa
					</a>
					<p class="mt-2 text-xs text-neutral-500">Busca capas candidatas no Deezer, iTunes e Wikidata pra você escolher manualmente.</p>

					if data.SearchedCovers {
						if len(data.CoverCandidates) == 0 {
							<p class="mt-3 text-xs text-neutral-500">Nenhuma capa candidata encontrada pra este artista.</p>
						} else {
							<div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-4">
								for i, cand := range data.CoverCandidates {
									<form method="POST" action={ templ.SafeURL("/admin/artistas/" + url.PathEscape(data.Artist) + "/capa/escolher") }>
										<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>
										<input type="hidden" name="source" value={ cand.Source }/>
										<input type="hidden" name="url" value={ cand.FullURL }/>
										<button
											type="submit"
											title={ "Usar esta capa (" + cand.Source + ")" }
											class="group block w-full overflow-hidden rounded-lg ring-1 ring-white/10 transition hover:ring-brand-400/60"
										>
											<img
												src={ cand.ThumbURL }
												alt={ "Capa candidata " + strconv.Itoa(i+1) + " (" + cand.Source + ")" }
												loading="lazy"
												class="aspect-square w-full object-cover"
											/>
											<span class="block truncate bg-black/60 px-1 py-0.5 text-[10px] text-neutral-300">{ cand.Source }</span>
										</button>
									</form>
								}
							</div>
						}
					}
				</div>
			</details>
		}

		<ul class="mt-4 divide-y divide-white/5 rounded-lg bg-surface-raised">
			for _, song := range data.Songs {
				@components.ArtistSongRow(song, data.CSRFToken, data.IsAdmin)
			}
		</ul>
	}
}
