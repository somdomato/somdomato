package pages

import (
	"github.com/somdomato/somdomato/web/templates"
	"github.com/somdomato/somdomato/web/templates/components"
)

type EnviarData struct {
	Player    components.PlayerData
	CSRFToken string
	Results   []components.EnviarSearchItem
	Query     string
	IsAdmin   bool
}

templ Enviar(data EnviarData) {
	@templates.Layout("Enviar música", &data.Player, data.IsAdmin) {
		<h1 class="text-xl font-bold">Manda tua música pra rádio</h1>
		<p class="mt-1 text-sm text-neutral-400">
			Busque no Deezer e peça o download. Toda música passa por uma avaliação automática antes de entrar no ar
			— pode levar alguns minutos.
		</p>

		<form class="mt-4" hx-get="/enviar/buscar" hx-target="#search-results" hx-trigger="input changed delay:300ms, search">
			<input
				type="search"
				name="q"
				value={ data.Query }
				placeholder="Buscar por título ou artista..."
				class="w-full rounded-lg bg-surface-raised px-4 py-2 text-sm outline-none focus:ring-2 focus:ring-brand-500"
			/>
		</form>

		<ul id="search-results" class="mt-3 divide-y divide-white/5 rounded-lg bg-surface-raised">
			for _, item := range data.Results {
				@components.EnviarResultRow(item, data.CSRFToken)
			}
		</ul>
	}
}
