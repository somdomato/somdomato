package pages

import (
	"github.com/somdomato/somdomato/web/templates"
)

templ NotFound() {
	@templates.Layout("Página não encontrada", nil, false) {
		<div class="flex flex-col items-center justify-center gap-6 py-16 text-center sm:py-24">
			<span class="text-7xl font-black tracking-tight text-brand-400 sm:text-8xl">404</span>
			<div class="flex flex-col gap-2">
				<h1 class="text-xl font-bold text-neutral-100 sm:text-2xl">Essa página saiu de cartaz</h1>
				<p class="max-w-md text-sm leading-relaxed text-neutral-400 sm:text-base">
					Não encontramos o que você procurava. Talvez o link esteja errado ou a página tenha sido movida.
				</p>
			</div>
			<div class="flex flex-wrap items-center justify-center gap-3">
				<a href="/" class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-2.5 text-sm font-semibold text-neutral-950 shadow-lg shadow-brand-500/20 transition hover:bg-brand-600">
					Voltar para o início
				</a>
				<a href="/pedidos" class="inline-flex items-center gap-2 rounded-full bg-white/5 px-5 py-2.5 text-sm font-semibold text-neutral-200 ring-1 ring-white/10 transition hover:bg-white/10">
					Fazer um pedido
				</a>
				<a href="/artistas" class="inline-flex items-center gap-2 rounded-full bg-white/5 px-5 py-2.5 text-sm font-semibold text-neutral-200 ring-1 ring-white/10 transition hover:bg-white/10">
					Ver artistas
				</a>
			</div>
		</div>
	}
}
